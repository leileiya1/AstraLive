APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://astralive:replace-me@localhost:5432/astralive?sslmode=disable
REDIS_URL=redis://localhost:6379/0
REDIS_RUNTIME_EVENT_STREAM=dh.runtime.events.v1
AI_RUNTIME_URL=http://localhost:8000
INTERNAL_API_TOKEN=replace-me
LOG_LEVEL=info
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Operator bootstrap only; end users configure Provider keys through the HTTPS UI.
# Leave origin empty to preserve existing v1.1 deployments without configuration routes.
CONFIG_PUBLIC_ORIGIN=
CONFIG_KEYRING_FILE=
CONFIG_IDENTITY_TOKEN_FILE=
CONFIG_WORKER_TOKEN_FILE=
# Exact public HTTPS custom LLM hostnames. DeepSeek is always allowed.
CONFIG_LLM_HOSTS=

# Operator-owned private Worker status registry. Empty keeps status probing unavailable.
GPU_WORKER_REGISTRY_FILE=
