// Strict frozen-schema runtime. Internal JSON nodes are never public DTO fields.
package wire

import (
 "bytes"
 "crypto/sha256"
 "encoding/hex"
 "encoding/json"
 "fmt"
 "io"
 "reflect"
 "regexp"
 "sort"
 "strconv"
 "strings"
 "time"
 "unicode/utf8"
 _ "embed"
)

const SafeInteger int64 = 9007199254740991
const MaxBodyBytes = 9437184
const ControlBodyBytes = 262144
const maxDepth = 128

// WireError intentionally contains no caller value, key, JSON fragment or cause.
type WireError struct { Code string }
func (e *WireError) Error() string { return e.Code }
func invalid(code string) error { return &WireError{Code:code} }

//go:embed schema.json
var schemaBytes []byte
var schemas map[string]any
var patterns = map[string]*regexp.Regexp{}
var integerPattern = regexp.MustCompile(`^-?(0|[1-9][0-9]*)$`)

func init() {
 sum := sha256.Sum256(schemaBytes)
 if hex.EncodeToString(sum[:]) != "@SCHEMA_HASH@" { panic("SCHEMA_INTEGRITY") }
 var root map[string]any
 d:=json.NewDecoder(bytes.NewReader(schemaBytes)); d.UseNumber()
 if d.Decode(&root)!=nil { panic("SCHEMA_INTEGRITY") }
 schemas=root["$defs"].(map[string]any)
 for name,path:=range @INLINE_PATHS@ { var v any=root;for _,key:=range path{v=node(v)[key]};schemas[name]=v }
 for _, pattern:=range []string{`^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$`,`^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d{1,9})?Z$`,`^[0-9a-f]{64}$`,`^[A-Za-z0-9_-]{43}$`} { patterns[pattern]=regexp.MustCompile(pattern) }
}

// Message is implemented by generated DTOs; Encode enforces registry types.
// Decode never returns an arbitrary map.
type Message interface { wireMessage(); SchemaName() string }

// Check escaped Unicode before encoding/json can silently replace a lone UTF16
// surrogate. Raw bytes must be UTF8, never auto-detected UTF16/32.
func unicodeJSON(b []byte) bool {
 if !utf8.Valid(b) { return false }
 for i:=0;i<len(b);i++ {
  if b[i]!='"' { continue }; i++
  for i<len(b) && b[i]!='"' {
   if b[i]!='\\' { i++;continue }
   if i+1>=len(b) { return false }
   if b[i+1]!='u' { i+=2;continue }
   if i+6>len(b) { return false }
   n,e:=strconv.ParseUint(string(b[i+2:i+6]),16,16);if e!=nil{return false}
   if n>=0xD800 && n<=0xDBFF {
    if i+12>len(b)||b[i+6]!='\\'||b[i+7]!='u' {return false}
    low,e:=strconv.ParseUint(string(b[i+8:i+12]),16,16);if e!=nil||low<0xDC00||low>0xDFFF{return false};i+=12
   } else { if n>=0xDC00&&n<=0xDFFF{return false};i+=6 }
  }
 }
 return true
}

func parse(raw []byte,limit int) (any,error) {
 if len(raw)>limit {return nil,invalid("BODY_TOO_LARGE")}
 if !unicodeJSON(raw) {return nil,invalid("INVALID_UTF8")}
 d:=json.NewDecoder(bytes.NewReader(raw));d.UseNumber()
 var read func(int)(any,error)
 read=func(depth int)(any,error){
  if depth>maxDepth{return nil,invalid("DEPTH_LIMIT")}
  token,e:=d.Token();if e!=nil{return nil,invalid("INVALID_JSON")}
  switch x:=token.(type) {
  case json.Delim:
   switch x {
   case '{':
    result:=map[string]any{}
    for d.More(){k,e:=d.Token();if e!=nil{return nil,invalid("INVALID_JSON")};key,ok:=k.(string);if !ok{return nil,invalid("INVALID_JSON")};if _,ok=result[key];ok{return nil,invalid("DUPLICATE_KEY")};v,e:=read(depth+1);if e!=nil{return nil,e};result[key]=v}
    if end,e:=d.Token();e!=nil||end!=json.Delim('}'){return nil,invalid("INVALID_JSON")};return result,nil
   case '[':
    result:=[]any{};for d.More(){v,e:=read(depth+1);if e!=nil{return nil,e};result=append(result,v)}
    if end,e:=d.Token();e!=nil||end!=json.Delim(']'){return nil,invalid("INVALID_JSON")};return result,nil
   };return nil,invalid("INVALID_JSON")
  case json.Number:
   if !integerPattern.MatchString(string(x))||len(x)>17{return nil,invalid("INVALID_NUMBER")}
   n,e:=x.Int64();if e!=nil||n>SafeInteger||n< -SafeInteger{return nil,invalid("INVALID_NUMBER")};return n,nil
  case string,bool,nil:return x,nil
  };return nil,invalid("INVALID_JSON")
 }
 v,e:=read(0);if e!=nil{return nil,e}
 if _,e=d.Token();e!=io.EOF{return nil,invalid("INVALID_JSON")}
 return v,nil
}

func node(v any) map[string]any { return v.(map[string]any) }
func number(v any) int64 { n,_:=v.(json.Number).Int64();return n }
func equal(a,b any) bool {
 if n,ok:=b.(json.Number);ok{v,e:=n.Int64();return e==nil&&reflect.DeepEqual(a,v)}
 return reflect.DeepEqual(a,b)
}
func valid(s map[string]any,v any) error {
 if ref,ok:=s["$ref"].(string);ok { if e:=valid(node(schemas[strings.TrimPrefix(ref,"#/$defs/")]),v);e!=nil{return e} }
 if t,ok:=s["type"].(string);ok {
  matches:=false
  switch t {case "object":_,matches=v.(map[string]any);case "array":_,matches=v.([]any);case "string":_,matches=v.(string);case "integer":_,matches=v.(int64);case "boolean":_,matches=v.(bool);case "null":matches=v==nil}
  if !matches{return invalid("INVALID_WIRE")}
 }
 if x,ok:=s["const"];ok&&!equal(v,x){return invalid("INVALID_WIRE")}
 if x,ok:=s["enum"].([]any);ok{found:=false;for _,candidate:=range x{if equal(v,candidate){found=true;break}};if !found{return invalid("INVALID_WIRE")}}
 if branches,ok:=s["anyOf"].([]any);ok{found:=false;for _,b:=range branches{if valid(node(b),v)==nil{found=true;break}};if !found{return invalid("INVALID_WIRE")}}
 if branches,ok:=s["allOf"].([]any);ok{for _,b:=range branches{if e:=valid(node(b),v);e!=nil{return e}}}
 if condition,ok:=s["if"];ok{branch:="else";if valid(node(condition),v)==nil{branch="then"};if b,ok:=s[branch];ok{if e:=valid(node(b),v);e!=nil{return e}}}
 switch x:=v.(type){
 case map[string]any:
  if required,ok:=s["required"].([]any);ok{for _,key:=range required{if _,ok=x[key.(string)];!ok{return invalid("MISSING_FIELD")}}}
  props,_:=s["properties"].(map[string]any)
  if s["additionalProperties"]==false{for k:=range x{if _,ok:=props[k];!ok{return invalid("EXTRA_FIELD")}}}
  for k,sp:=range props{if value,ok:=x[k];ok{if e:=valid(node(sp),value);e!=nil{return e}}}
 case []any:
  if n,ok:=s["minItems"];ok&&int64(len(x))<number(n){return invalid("INVALID_WIRE")};if n,ok:=s["maxItems"];ok&&int64(len(x))>number(n){return invalid("INVALID_WIRE")}
  if s["uniqueItems"]==true{seen:=map[string]bool{};for _,item:=range x{b:=canonical(item);if seen[string(b)]{return invalid("INVALID_WIRE")};seen[string(b)]=true}}
  if sp,ok:=s["items"];ok{for _,item:=range x{if e:=valid(node(sp),item);e!=nil{return e}}}
 case string:
  length:=int64(utf8.RuneCountInString(x));if n,ok:=s["minLength"];ok&&length<number(n){return invalid("INVALID_WIRE")};if n,ok:=s["maxLength"];ok&&length>number(n){return invalid("INVALID_WIRE")}
  if p,ok:=s["pattern"].(string);ok{r:=patterns[p];if r==nil{panic("UNSUPPORTED_SCHEMA_PATTERN")};if !r.MatchString(x){return invalid("INVALID_WIRE")}}
  if s["format"]=="date-time"{t,e:=time.Parse(time.RFC3339Nano,x);if e!=nil||t.Year()<1{return invalid("INVALID_WIRE")}}
 case int64:
  if n,ok:=s["minimum"];ok&&x<number(n){return invalid("INVALID_WIRE")};if n,ok:=s["maximum"];ok&&x>number(n){return invalid("INVALID_WIRE")}
 }
 // contentEncoding is annotation-only; media decoding/signature verification
 // belong to the separately authenticated adapter, not structural DTO decode.
 return nil
}

// fill uses only generated closed fields. It cannot allocate caller-chosen Go
// types, fall back to a map/RawMessage field or coerce JSON primitive types.
func fill(dst reflect.Value,v any) {
 if v==nil{return}
 if dst.Kind()==reflect.Pointer{dst.Set(reflect.New(dst.Type().Elem()));fill(dst.Elem(),v);return}
 switch dst.Kind(){
 case reflect.Struct:
  obj:=v.(map[string]any);t:=dst.Type();for i:=0;i<dst.NumField();i++{fill(dst.Field(i),obj[t.Field(i).Tag.Get("json")])}
 case reflect.Slice:
  arr:=v.([]any);dst.Set(reflect.MakeSlice(dst.Type(),len(arr),len(arr)));for i,item:=range arr{fill(dst.Index(i),item)}
 case reflect.String:dst.SetString(v.(string))
 case reflect.Int64:dst.SetInt(v.(int64))
 case reflect.Bool:dst.SetBool(v.(bool))
 default:panic("UNSUPPORTED_GENERATED_TYPE")
 }
}
func plain(v reflect.Value,depth int)(any,error){
 if depth>maxDepth{return nil,invalid("DEPTH_LIMIT")}
 if v.Kind()==reflect.Pointer{if v.IsNil(){return nil,nil};return plain(v.Elem(),depth+1)}
 switch v.Kind(){
 case reflect.Struct:
  result:=map[string]any{};for i:=0;i<v.NumField();i++{x,e:=plain(v.Field(i),depth+1);if e!=nil{return nil,e};result[v.Type().Field(i).Tag.Get("json")]=x};return result,nil
 case reflect.Slice:
  if v.IsNil(){return nil,nil};result:=[]any{};for i:=0;i<v.Len();i++{x,e:=plain(v.Index(i),depth+1);if e!=nil{return nil,e};result=append(result,x)};return result,nil
 case reflect.String:if !utf8.ValidString(v.String()){return nil,invalid("INVALID_UTF8")};return v.String(),nil
 case reflect.Int64:n:=v.Int();if n>SafeInteger||n< -SafeInteger{return nil,invalid("INVALID_NUMBER")};return n,nil
 case reflect.Bool:return v.Bool(),nil
 };return nil,invalid("INVALID_WIRE")
}
func unmarshalNamed(name string,raw []byte,dst any)error{
 s,ok:=schemas[name];if !ok{return invalid("UNKNOWN_SCHEMA")}
 v,e:=parse(raw,MaxBodyBytes);if e!=nil{return e};if e=valid(node(s),v);e!=nil{return e}
 // Decode into a fresh value, even when the caller reuses a populated object:
 // explicit null must clear an old pointer, and failed decode must be atomic.
 ptr:=reflect.ValueOf(dst);if ptr.Kind()!=reflect.Pointer||ptr.IsNil(){return invalid("DTO_REQUIRED")};target:=ptr.Elem();fresh:=reflect.New(target.Type()).Elem();fill(fresh,v);target.Set(fresh);return nil
}
func marshalNamed(name string,value any)([]byte,error){
 v,e:=plain(reflect.ValueOf(value),0);if e!=nil{return nil,e};if e=valid(node(schemas[name]),v);e!=nil{return nil,e}
 b:=canonical(v);if len(b)>MaxBodyBytes{return nil,invalid("BODY_TOO_LARGE")};return b,nil
}
func Decode(name string,raw []byte)(Message,error){
 factory,ok:=factories[name];if !ok{return nil,invalid("UNKNOWN_SCHEMA")};m:=factory();if e:=unmarshalNamed(name,raw,m);e!=nil{return nil,e};return m,nil
}
func Encode(m Message)([]byte,error){if m==nil || (reflect.ValueOf(m).Kind()==reflect.Pointer && reflect.ValueOf(m).IsNil()){return nil,invalid("DTO_REQUIRED")};name:=m.SchemaName();if _,ok:=factories[name];!ok || !messageType(m,name){return nil,invalid("DTO_REQUIRED")};return marshalNamed(name,m)}

func quote(b *bytes.Buffer,s string){
 b.WriteByte('"');for _,r:=range s{switch r{case '"':b.WriteString(`\"`);case '\\':b.WriteString(`\\`);case '\b':b.WriteString(`\b`);case '\f':b.WriteString(`\f`);case '\n':b.WriteString(`\n`);case '\r':b.WriteString(`\r`);case '\t':b.WriteString(`\t`);default:if r<32{fmt.Fprintf(b,`\u%04x`,r)}else{b.WriteRune(r)}}};b.WriteByte('"')
}
func canonical(v any)[]byte{
 var b bytes.Buffer;var emit func(any)
 emit=func(value any){switch x:=value.(type){case nil:b.WriteString("null");case bool:b.WriteString(strconv.FormatBool(x));case int64:b.WriteString(strconv.FormatInt(x,10));case string:quote(&b,x);case []any:b.WriteByte('[');for i,item:=range x{if i>0{b.WriteByte(',')};emit(item)};b.WriteByte(']');case map[string]any:keys:=make([]string,0,len(x));for k:=range x{keys=append(keys,k)};sort.Strings(keys);b.WriteByte('{');for i,k:=range keys{if i>0{b.WriteByte(',')};quote(&b,k);b.WriteByte(':');emit(x[k])};b.WriteByte('}')}}
 emit(v);return b.Bytes()
}
// CanonicalJSON is a value utility for frozen hashes/vectors, not a DTO or
// authority decoder. It rejects floating-point and unsafe-number lexemes.
func CanonicalJSON(raw []byte)([]byte,error){v,e:=parse(raw,MaxBodyBytes);if e!=nil{return nil,e};return canonical(v),nil}
func DigestJSON(raw []byte)(string,error){b,e:=CanonicalJSON(raw);if e!=nil{return "",e};sum:=sha256.Sum256(b);return hex.EncodeToString(sum[:]),nil}

// RequestContext must come from authenticated transport. It merely selects and
// checks a descriptor here; it does not authenticate the caller or a Run.
type RequestContext struct { Role Role; Target Target; Method string; RouteTemplate string }
func requestContext(id OperationID,ctx RequestContext)(Operation,error){
 op,ok:=operationTable[id];if !ok{return Operation{},invalid("UNKNOWN_OPERATION")};allowed:=false;for _,r:=range op.Roles{if r==ctx.Role{allowed=true}}
 if !allowed||ctx.Target!=op.Target||ctx.Method!=op.Method||ctx.RouteTemplate!=op.Path{return Operation{},invalid("ENDPOINT_MISMATCH")}
 return op,nil
}
func DecodeRequest(id OperationID,ctx RequestContext,raw []byte)(Message,error){
 op,e:=requestContext(id,ctx);if e!=nil{return nil,e}
 if len(raw)>op.MaxBodyBytes{return nil,invalid("BODY_TOO_LARGE")};return Decode(op.RequestSchema,raw)
}
func DecodeResponse(id OperationID,status int,raw []byte)(Message,error){
 op,ok:=operationTable[id];if !ok{return nil,invalid("UNKNOWN_OPERATION")};if len(raw)>op.MaxBodyBytes{return nil,invalid("BODY_TOO_LARGE")}
 if status==op.SuccessStatus{return Decode(op.ResponseSchema,raw)}
 known:=false;for _,s:=range op.ErrorCodes{if s==status{known=true}};if !known{return nil,invalid("STATUS_MISMATCH")}
 m,e:=Decode(op.ErrorSchema,raw);if e!=nil{return nil,e}
 v:=reflect.ValueOf(m).Elem().FieldByName("Code").String();if want,ok:=op.ErrorCodes[v];!ok||want!=status{return nil,invalid("STATUS_MISMATCH")};return m,nil
}

// ReadRequest bounds allocation before decode. The caller owns read deadlines;
// this pure codec does not hold locks or perform authentication/network I/O.
func ReadRequest(id OperationID,ctx RequestContext,r io.Reader)(Message,error){
 op,e:=requestContext(id,ctx);if e!=nil{return nil,e}
 b,e:=io.ReadAll(io.LimitReader(r,int64(op.MaxBodyBytes)+1));if e!=nil{return nil,invalid("READ_FAILED")};return DecodeRequest(id,ctx,b)
}

func messageType(m Message,name string)bool {
 if m==nil{return false};t:=reflect.TypeOf(m);if t.Kind()==reflect.Pointer{t=t.Elem()}
 return t==reflect.TypeOf(factories[name]()).Elem()
}
func EncodeRequest(id OperationID,ctx RequestContext,m Message)([]byte,error){
 op,e:=requestContext(id,ctx);if e!=nil{return nil,e};if !messageType(m,op.RequestSchema){return nil,invalid("DTO_REQUIRED")}
 b,e:=Encode(m);if e!=nil{return nil,e};if len(b)>op.MaxBodyBytes{return nil,invalid("BODY_TOO_LARGE")};return b,nil
}
func EncodeResponse(id OperationID,status int,m Message)([]byte,error){
 op,ok:=operationTable[id];if !ok{return nil,invalid("UNKNOWN_OPERATION")};name:=op.ResponseSchema;if status!=op.SuccessStatus{name=op.ErrorSchema}
 if !messageType(m,name){return nil,invalid("DTO_REQUIRED")};b,e:=Encode(m);if e!=nil{return nil,e};if _,e=DecodeResponse(id,status,b);e!=nil{return nil,e};return b,nil
}

// VerifyAnswerArtifactHashes verifies the frozen text/descriptor hash equations.
// It does not verify assertions/facts, source authority or execution eligibility.
func VerifyAnswerArtifactHashes(a *AnswerArtifact)error {
 if a==nil{return invalid("DTO_REQUIRED")}
 raw,e:=Encode(a);if e!=nil{return e};v,e:=parse(raw,MaxBodyBytes);if e!=nil{return e};body:=v.(map[string]any)
 text:=sha256.Sum256([]byte(body["answerText"].(string)))
 if hex.EncodeToString(text[:])!=body["answerTextHash"].(string){return invalid("ANSWER_CONFLICT")}
 expected:=body["artifactHash"].(string);delete(body,"artifactHash");sum:=sha256.Sum256(canonical(body))
 if hex.EncodeToString(sum[:])!=expected{return invalid("ANSWER_CONFLICT")};return nil
}
