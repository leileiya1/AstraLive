"""Strict frozen-schema codec. No transport, SQL, grants or media effects.

JSON data is internal to the validator; public decoded values are closed DTOs.
Use encode/to_json only for intentional wire emission, never for diagnostics.
"""
import dataclasses
import datetime
import hashlib
import hmac
import json
from pathlib import Path
import re

SAFE_INTEGER = 9007199254740991
MAX_DEPTH = 128
MAX_BODY_BYTES = 9437184
CONTROL_BODY_BYTES = 262144

class WireError(ValueError):
    """Never retain caller-controlled values or the underlying decoder error."""

class WireModel:
    __slots__ = ()
    def __repr__(self): return type(self).__name__ + '(<redacted>)'
    __str__ = __repr__
    def __post_init__(self):
        name = type(self).__name__
        value = _plain(self)
        _tree(value)
        _validate(_SCHEMA['$defs'][name], value)
        for f in dataclasses.fields(self):
            object.__setattr__(self, f.name, _build(_resolved(name)['properties'][f.name], value[f.name]))
    def to_json(self): return encode(self)
    @classmethod
    def from_json(cls, data): return decode(cls.__name__, data)

class SecretString:
    """Opaque secret: json.dumps cannot accidentally serialize its plaintext."""
    __slots__ = ('_value',)
    def __repr__(self): return '<redacted>'
    __str__ = __repr__
    def __format__(self, spec): return '<redacted>'
    def __setattr__(self, key, value): raise AttributeError('immutable secret')
    def __eq__(self, other): return type(self) is type(other) and hmac.compare_digest(self._value, other._value)
    def __hash__(self): return hash(self._value)
    def __copy__(self): return self
    def __deepcopy__(self, memo): return self

def _secret(cls, value):
    obj = object.__new__(cls)
    object.__setattr__(obj, '_value', value)
    return obj

# Loading validates the generated schema mirror itself, not mutable approval text.
_SCHEMA_BYTES = Path(__file__).with_name('schema.json').read_bytes()
if hashlib.sha256(_SCHEMA_BYTES).hexdigest() != '@SCHEMA_HASH@':
    raise WireError('SCHEMA_INTEGRITY')
_SCHEMA = json.loads(_SCHEMA_BYTES)
_INLINE_NAMES = {}
for _name, _path in @INLINE_PATHS@.items():
    _node = _SCHEMA
    for _part in _path: _node = _node[_part]
    _INLINE_NAMES[id(_node)] = _name
    _SCHEMA['$defs'][_name] = _node
MODELS = {}  # Generated concrete model registry, populated by models.py.
OPERATIONS = {}  # Immutable descriptors populated by operations.py.


def _bad(code='INVALID_WIRE'): raise WireError(code) from None

def _pairs(items):
    result = {}
    for k, v in items:
        if k in result: _bad('DUPLICATE_KEY')
        result[k] = v
    return result

def _integer(s):
    if len(s) > 17: _bad('INVALID_NUMBER')
    n = int(s)
    if abs(n) > SAFE_INTEGER: _bad('INVALID_NUMBER')
    return n

def _number(_): _bad('INVALID_NUMBER')

def _tree(value, depth=0):
    if depth > MAX_DEPTH: _bad('DEPTH_LIMIT')
    if isinstance(value, str):
        try: str.__str__(value).encode('utf-8', 'strict')
        except UnicodeError: _bad('INVALID_UTF8')
    elif isinstance(value, bool) or value is None: pass
    elif isinstance(value, int):
        if abs(value) > SAFE_INTEGER: _bad('INVALID_NUMBER')
    elif isinstance(value, (list, tuple)):
        for v in value: _tree(v, depth + 1)
    elif isinstance(value, dict):
        for k, v in value.items():
            if not isinstance(k, str): _bad()
            _tree(k, depth + 1); _tree(v, depth + 1)
    else: _bad('INVALID_NUMBER' if isinstance(value, float) else 'INVALID_WIRE')

def parse(data, limit=MAX_BODY_BYTES):
    if type(data) is not bytes: _bad('BYTES_REQUIRED')
    if len(data) > limit: _bad('BODY_TOO_LARGE')
    failed = False
    try:
        # Do not allow json.loads(bytes) to auto-detect UTF16/32 or a BOM.
        text = data.decode('utf-8', 'strict')
        value = json.loads(text, object_pairs_hook=_pairs, parse_int=_integer,
                           parse_float=_number, parse_constant=_number)
        _tree(value)
    except WireError: raise
    except (ValueError, UnicodeError, RecursionError): failed = True
    if failed: _bad('INVALID_JSON')  # Outside except: no raw JSON error context.
    return value

def _resolved(name):
    if name not in _SCHEMA['$defs']: _bad('UNKNOWN_SCHEMA')
    s = _SCHEMA['$defs'][name]
    return _resolved(s['$ref'].split('/')[-1]) if '$ref' in s else s

def _equal(a, b):
    return type(a) is type(b) and a == b

def _validate(s, v):
    if '$ref' in s: _validate(_SCHEMA['$defs'][s['$ref'].split('/')[-1]], v)
    t = s.get('type')
    if t and not {'object': type(v) is dict, 'array': type(v) is list,
                  'string': type(v) is str, 'integer': type(v) is int,
                  'boolean': type(v) is bool, 'null': v is None}.get(t, False): _bad()
    if 'const' in s and not _equal(v, s['const']): _bad()
    if 'enum' in s and not any(_equal(v, x) for x in s['enum']): _bad()
    if 'anyOf' in s:
        valid = False
        for branch in s['anyOf']:
            try: _validate(branch, v); valid = True; break
            except WireError: pass
        if not valid: _bad()
    for branch in s.get('allOf', ()): _validate(branch, v)
    if 'if' in s:
        try: _validate(s['if'], v); matches = True
        except WireError: matches = False
        _validate(s.get('then' if matches else 'else', {}), v)
    if type(v) is dict:
        if any(k not in v for k in s.get('required', ())): _bad('MISSING_FIELD')
        props = s.get('properties', {})
        if s.get('additionalProperties') is False and any(k not in props for k in v): _bad('EXTRA_FIELD')
        for k, child in props.items():
            if k in v: _validate(child, v[k])
    if type(v) is list:
        if len(v) < s.get('minItems', 0) or len(v) > s.get('maxItems', MAX_BODY_BYTES): _bad()
        if s.get('uniqueItems') and len({canonical_json(x) for x in v}) != len(v): _bad()
        if 'items' in s:
            for x in v: _validate(s['items'], x)
    if type(v) is str:
        if len(v) < s.get('minLength', 0) or len(v) > s.get('maxLength', MAX_BODY_BYTES): _bad()
        if 'pattern' in s and re.fullmatch(s['pattern'], v, re.ASCII) is None: _bad()
        if s.get('format') == 'date-time':
            try: datetime.datetime.fromisoformat(v.replace('Z', '+00:00'))
            except ValueError: _bad()
    if type(v) is int and not s.get('minimum', -SAFE_INTEGER) <= v <= s.get('maximum', SAFE_INTEGER): _bad()
    # contentEncoding is a JSON Schema annotation, not an assertion. Actual
    # media base64 decoding, cryptographic signatures and authority are separate.

def _plain(v):
    if isinstance(v, SecretString): return v._value
    if isinstance(v, WireModel): return {f.name: _plain(getattr(v, f.name)) for f in dataclasses.fields(v)}
    if isinstance(v, str): return str.__str__(v)
    if isinstance(v, bool) or v is None: return v
    if isinstance(v, int): return int(v)
    if isinstance(v, (tuple, list)): return [_plain(x) for x in v]
    if type(v) is dict: return {k: _plain(x) for k, x in v.items()}
    _bad()

def canonical_json(v):
    v = _plain(v); _tree(v)
    return json.dumps(v, sort_keys=True, separators=(',', ':'), ensure_ascii=False, allow_nan=False).encode('utf-8')

def digest(v): return hashlib.sha256(canonical_json(v)).hexdigest()

def _build(s, v):
    if '$ref' in s: return _build_named(s['$ref'].split('/')[-1], v)
    if 'anyOf' in s:
        if v is None: return None
        return _build(next(b for b in s['anyOf'] if b.get('type') != 'null'), v)
    if s.get('type') == 'array': return tuple(_build(s['items'], x) for x in v)
    if s.get('type') == 'object': return _build_named(_INLINE_NAMES[id(s)], v)
    return v

def _build_named(name, v):
    cls = MODELS[name]; s = _resolved(name)
    if s.get('type') == 'object':
        obj = object.__new__(cls)
        for key, spec in s['properties'].items(): object.__setattr__(obj, key, _build(spec, v[key]))
        return obj
    if issubclass(cls, SecretString): return _secret(cls, v)
    return str.__new__(cls, v) if s['type'] == 'string' else int.__new__(cls, v)

def scalar(name, v):
    _tree(v); _validate(_SCHEMA['$defs'][name], v)
    cls = MODELS[name]
    if issubclass(cls, SecretString): return _secret(cls, v)
    return str.__new__(cls, v) if _resolved(name)['type'] == 'string' else int.__new__(cls, v)

def decode(name, data):
    if name not in MODELS: _bad('UNKNOWN_SCHEMA')
    v = parse(data); _validate(_SCHEMA['$defs'][name], v)
    return _build_named(name, v)

def encode(model):
    name = type(model).__name__
    if name not in MODELS or type(model) is not MODELS[name]: _bad('DTO_REQUIRED')
    v = _plain(model); _tree(v); _validate(_SCHEMA['$defs'][name], v)
    raw = canonical_json(v)
    if len(raw) > MAX_BODY_BYTES: _bad('BODY_TOO_LARGE')
    return raw

def decode_request(operation, body, *, role, target, method, route_template):
    # role is supplied by the future authenticated transport, NEVER JSON. This
    # is a descriptor match, not authentication or authorization of a Run.
    op = OPERATIONS.get(operation)
    if op is None: _bad('UNKNOWN_OPERATION')
    if role not in op.roles or (target, method, route_template) != (op.target, op.method, op.path): _bad('ENDPOINT_MISMATCH')
    if len(body) > op.max_body_bytes: _bad('BODY_TOO_LARGE')
    return decode(op.request_schema, body)

def decode_response(operation, body, *, status):
    op = OPERATIONS.get(operation)
    if op is None: _bad('UNKNOWN_OPERATION')
    if len(body) > op.max_body_bytes: _bad('BODY_TOO_LARGE')
    if status == op.success_status: return decode(op.response_schema, body)
    if status not in op.error_statuses: _bad('STATUS_MISMATCH')
    response = decode(op.error_schema, body)
    if response.code not in op.error_codes or op.error_codes[response.code] != status: _bad('STATUS_MISMATCH')
    return response


def encode_request(operation, model, *, role, target, method, route_template):
    op = OPERATIONS.get(operation)
    if op is None: _bad('UNKNOWN_OPERATION')
    if type(model) is not MODELS[op.request_schema]: _bad('DTO_REQUIRED')
    body = encode(model)
    decode_request(operation, body, role=role, target=target, method=method, route_template=route_template)
    return body

def encode_response(operation, model, *, status):
    op = OPERATIONS.get(operation)
    if op is None: _bad('UNKNOWN_OPERATION')
    name = op.response_schema if status == op.success_status else op.error_schema
    if type(model) is not MODELS[name]: _bad('DTO_REQUIRED')
    body = encode(model)
    decode_response(operation, body, status=status)
    return body

def verify_answer_artifact_hashes(artifact):
    """Deterministic descriptor integrity only; no fact/source/START authority."""
    if type(artifact) is not MODELS['AnswerArtifact']: _bad('DTO_REQUIRED')
    encode(artifact)  # Require structural validity as well.
    body = _plain(artifact)
    text_hash = hashlib.sha256(body['answerText'].encode('utf-8')).hexdigest()
    descriptor_hash = digest({k: v for k, v in body.items() if k != 'artifactHash'})
    if not hmac.compare_digest(text_hash, body['answerTextHash']) or not hmac.compare_digest(descriptor_hash, body['artifactHash']):
        _bad('ANSWER_CONFLICT')
