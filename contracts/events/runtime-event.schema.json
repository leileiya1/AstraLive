{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astralive.local/contracts/events/runtime-event.schema.json",
  "title": "RuntimeEvent",
  "type": "object",
  "required": ["schemaVersion", "eventId", "eventType", "sessionId", "utteranceId", "traceId", "occurredAt", "source", "payload"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "eventId": {"type": "string", "minLength": 1},
    "eventType": {"enum": ["SESSION_PREPARING", "SESSION_READY", "SESSION_STARTED", "SESSION_DEGRADED", "SESSION_STOPPING", "SESSION_ENDED", "SESSION_FAILED", "UTTERANCE_QUEUED", "UTTERANCE_GENERATING", "UTTERANCE_SYNTHESIZING", "UTTERANCE_RENDERING", "UTTERANCE_PLAYING", "UTTERANCE_COMPLETED", "UTTERANCE_INTERRUPTED", "UTTERANCE_FAILED", "MEDIA_READY", "MEDIA_FAILED", "RUNTIME_WARNING", "RUNTIME_ERROR"]},
    "sessionId": {"type": "string", "minLength": 1},
    "utteranceId": {"type": ["string", "null"]},
    "traceId": {"type": "string", "minLength": 1},
    "occurredAt": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "source": {"const": "AI_RUNTIME"},
    "payload": {"type": "object"}
  },
  "additionalProperties": false
}
