POSTGRES_PASSWORD=astralive-local-only
INTERNAL_API_TOKEN=astralive-local-token
MINIO_ACCESS_KEY=astralive
MINIO_SECRET_KEY=astralive-local-only
BACKEND_PORT=18080
FRONTEND_PORT=18081
RUNTIME_SERVICE=mock-runtime
# Vite build-time variables; also set these in frontend/.env.local or the frontend build environment.
VITE_WEBRTC_STUN_URLS=
VITE_WEBRTC_TURN_URLS=
VITE_WEBRTC_TURN_USERNAME=
VITE_WEBRTC_TURN_CREDENTIAL=

# Headless Runtime output. These are local test values, never real platform secrets.
WEBRTC_ENABLED=true
RTMP_ENABLED=false
RTMP_URL=rtmp://127.0.0.1:1935/live
RTMP_STREAM_KEY=astralive-test
RTMP_WIDTH=720
RTMP_HEIGHT=1280
RTMP_FPS=25
RTMP_VIDEO_BITRATE=3000k
RTMP_AUDIO_BITRATE=128k
RTMP_AUDIO_SAMPLE_RATE=48000
RTMP_PRESET=veryfast
RTMP_VIDEO_BUFFER_MS=400
RTMP_AUDIO_BUFFER_MS=400
