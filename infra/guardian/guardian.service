[Unit]
Description=AstraLive dedicated Room Output Guardian
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=astralive-guardian
Group=astralive-ipc
WorkingDirectory=/opt/astralive
ExecStart=/opt/astralive/.venv-guardian/bin/python -m output_guardian.supervisor --config /etc/astralive-guardian/config.json
Restart=on-failure
RestartSec=1
KillMode=control-group
TimeoutStopSec=3
SendSIGKILL=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/state /ipc /recordings
UMask=0077

[Install]
WantedBy=multi-user.target
