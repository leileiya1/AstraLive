# Optional explicit path overrides; operator side only. All other policy is in JSON.
ASTRALIVE_GPU_LAB_ROOT=/root/autodl-tmp/astralive-avatar-lab
ASTRALIVE_GPU_STATE_DIR=/root/autodl-tmp/astralive-services/soulx-lite-01
ASTRALIVE_GPU_PYTHON=/root/autodl-tmp/astralive-avatar-lab/environments/astralive-soulx/bin/python
ASTRALIVE_GPU_TOKEN_FILE=/root/autodl-tmp/astralive-services/secrets/worker-token
ASTRALIVE_GPU_MANAGEMENT_TOKEN_FILE=/root/autodl-tmp/astralive-services/secrets/management-token
