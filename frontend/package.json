{
  "name": "astralive-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:api": "openapi-typescript ../contracts/control-api.openapi.yaml -o src/api/generated.ts",
    "build": "bun run generate:api && bun run generate:config-api && bun run generate:personal-api && tsgo --noEmit && vite build",
    "test": "vitest run",
    "generate:config-api": "openapi-typescript ../contracts/user-config/schema.json -o src/api/config-generated.ts",
    "generate:personal-api": "openapi-typescript ../contracts/personal-assets/schema.json -o src/api/personal-assets-generated.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.90.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "motion": "14.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript/native-preview": "latest",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^27.0.0",
    "openapi-typescript": "^7.10.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
