{
  "openapi": "3.0.3",
  "info": {
    "title": "AstraLive Session Integration",
    "version": "0.4.0"
  },
  "paths": {
    "/api/v0.4/auth/me": {
      "get": {
        "responses": {
          "200": {
            "description": "Existing OK envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Identity"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v0.4/auth/login": {
      "post": {
        "responses": {
          "200": {
            "description": "Existing OK envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Identity"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "additionalProperties": false,
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "writeOnly": true,
                    "minLength": 12,
                    "maxLength": 72
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/v0.4/sessions/{sessionId}/providers": {
      "get": {
        "responses": {
          "200": {
            "description": "Existing OK envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/SessionProviders"
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "sessionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v0.4/auth/logout": {
      "post": {
        "responses": {
          "200": {
            "description": "Revoked server session and expired cookies"
          }
        }
      }
    },
    "/api/v0.4/workers/": {
      "get": {
        "description": "Only registry entries explicitly allowing the authenticated scope; never ports, credentials or SSH information. Status uses the existing trusted Worker probe.",
        "responses": {
          "200": {
            "description": "OK envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/WorkerChoice"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Identity": {
        "type": "object",
        "required": [
          "identity",
          "mode"
        ],
        "properties": {
          "identity": {
            "type": "object",
            "required": [
              "tenantId",
              "userId"
            ],
            "properties": {
              "tenantId": {
                "type": "string"
              },
              "userId": {
                "type": "string"
              }
            }
          },
          "mode": {
            "type": "string",
            "enum": [
              "SINGLE_OPERATOR"
            ]
          },
          "expiresInSeconds": {
            "type": "integer"
          }
        }
      },
      "SessionProviders": {
        "type": "object",
        "required": [
          "integrationVersion",
          "sessionId",
          "bindingId",
          "capturedAt",
          "expiresAt",
          "profiles",
          "mode",
          "errorCode",
          "workerEpoch"
        ],
        "properties": {
          "integrationVersion": {
            "type": "string",
            "enum": [
              "0.4.0"
            ]
          },
          "sessionId": {
            "type": "string"
          },
          "bindingId": {
            "type": "string"
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "profiles": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "profileId",
                "kind",
                "provider",
                "version",
                "updatedAt"
              ],
              "properties": {
                "profileId": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "provider": {
                  "type": "string"
                },
                "version": {
                  "type": "integer"
                },
                "updatedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "mode": {
            "type": "string",
            "enum": [
              "REAL",
              "DEGRADED",
              "UNAVAILABLE"
            ]
          },
          "errorCode": {
            "type": "string"
          },
          "workerEpoch": {
            "type": "string"
          }
        }
      },
      "WorkerChoice": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workerRef",
          "avatarRef",
          "ready",
          "errorCode"
        ],
        "properties": {
          "workerRef": {
            "type": "string"
          },
          "avatarRef": {
            "type": "string"
          },
          "ready": {
            "type": "boolean"
          },
          "errorCode": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "productSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "astralive_user_session"
      }
    }
  },
  "security": [
    {
      "productSession": []
    }
  ]
}
