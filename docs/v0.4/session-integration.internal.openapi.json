{
  "openapi": "3.0.3",
  "info": {
    "title": "AstraLive PRIVATE Session Integration",
    "version": "0.4.0"
  },
  "paths": {
    "/internal/v0.4/sessions/{sessionId}/binding": {
      "parameters": [
        {
          "name": "sessionId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "get": {
        "operationId": "resolveOwnedSessionBinding",
        "security": [
          {
            "bindingConsumer": []
          }
        ],
        "description": "Backend only. Derive scope from trusted Session mapping; never caller-supplied scope. Sensitive response: private transport, no-store, no body logging. Existing0.3 Resolve and24h lease remain authoritative.",
        "responses": {
          "200": {
            "description": "Existing OK envelope with private captured credentials",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "OK"
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/ResolvedSession"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Lease exhausted, missing binding or unsupported selection"
          },
          "503": {
            "description": "Binding/Worker unavailable"
          }
        }
      },
      "delete": {
        "operationId": "releaseOwnedSessionBinding",
        "security": [
          {
            "bindingConsumer": []
          }
        ],
        "description": "Backend only. Idempotently release existing0.3 binding using server-owned mapping; retain safe summary.",
        "responses": {
          "200": {
            "description": "Existing OK envelope, empty data"
          }
        }
      }
    },
    "/internal/v0.4/sessions/{sessionId}/providers": {
      "parameters": [
        {
          "name": "sessionId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "get": {
        "operationId": "runtimeSessionProviders",
        "security": [
          {
            "runtimeControl": []
          }
        ],
        "description": "Runtime only. Safe actual status; browser must use owner-checked Go projection.",
        "responses": {
          "200": {
            "description": "Unwrapped safe summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "session-integration.openapi.json#/components/schemas/SessionProviders"
                }
              }
            }
          },
          "404": {
            "description": "Session no longer active"
          }
        }
      }
    },
    "/internal/v0.4/provider-probes/tts": {
      "post": {
        "operationId": "runtimeXiaoYaProbe",
        "security": [
          {
            "runtimeControl": []
          }
        ],
        "description": "Runtime only. Serialized15s synthesis of fixed Chinese phrase using installed XiaoYa assets; no caller text or credentials.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/XiaoYaProbe"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Nonzero real PCM synthesized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/XiaoYaProbeResult"
                }
              }
            }
          },
          "429": {
            "description": "Concurrent probe busy"
          },
          "502": {
            "description": "Synthesis/model unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bindingConsumer": {
        "type": "http",
        "scheme": "bearer",
        "description": "CONFIG_WORKER_TOKEN_FILE; never user cookie"
      },
      "runtimeControl": {
        "type": "http",
        "scheme": "bearer",
        "description": "Distinct RUNTIME_CONTROL_TOKEN_FILE; never binding/Tool/user token"
      }
    },
    "schemas": {
      "ResolvedSession": {
        "type": "object",
        "required": [
          "integrationVersion",
          "scope",
          "binding",
          "credentials",
          "capturedAt"
        ],
        "properties": {
          "integrationVersion": {
            "type": "string",
            "enum": [
              "0.4.0"
            ]
          },
          "scope": {
            "$ref": "../../contracts/user-config/schema.json#/components/schemas/Scope"
          },
          "binding": {
            "$ref": "../../contracts/user-config/schema.json#/components/schemas/Binding"
          },
          "credentials": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "profileId -> decrypted captured credential; NEVER public/browser/logged"
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "XiaoYaProbe": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "voiceId",
          "modelRef",
          "speed"
        ],
        "properties": {
          "voiceId": {
            "type": "string",
            "enum": [
              "xiao_ya"
            ]
          },
          "modelRef": {
            "type": "string",
            "enum": [
              "xiaoya-default"
            ]
          },
          "speed": {
            "type": "number",
            "enum": [
              1
            ]
          }
        }
      },
      "XiaoYaProbeResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "real",
          "sampleRate",
          "samples"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "xiaoya"
            ]
          },
          "real": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "sampleRate": {
            "type": "integer",
            "minimum": 8000
          },
          "samples": {
            "type": "integer",
            "minimum": 1600
          }
        }
      }
    }
  }
}
