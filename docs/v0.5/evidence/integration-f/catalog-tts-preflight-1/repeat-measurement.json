  "rows": [
    {
      "factId": "product.name",
      "text": "这份电子说明书的名称，叫作桌面整理指南。",
      "sourceSamples16k": 68366,
      "padSamples": 114,
      "paddedSamples": 68480,
      "durationSeconds": 4.28,
      "pcmSHA256": "3978884c8c0bafeed15157bd70f45595e4808127f903c00f233d8da7f3ca3a42",
      "synthesisWallSeconds": 0.23647349991369992
    },
    {
      "factId": "product.price",
      "text": "这份桌面整理指南，当前标价是人民币九十九元。",
      "sourceSamples16k": 73688,
      "padSamples": 552,
      "paddedSamples": 74240,
      "durationSeconds": 4.64,
      "pcmSHA256": "6ce0a306ca4609713dad0f1cdf797a32d153ad11b18a4d932a0c58f1dc7ad8fd",
      "synthesisWallSeconds": 0.17626633297186345
    },
    {
      "factId": "product.stock",
      "text": "当前用于本次演示的商品库存，共有二十份可供选择。",
      "sourceSamples16k": 81504,
      "padSamples": 416,
      "paddedSamples": 81920,
      "durationSeconds": 5.12,
      "pcmSHA256": "44bffd243aff91f09bbe94c3b40a202b5d7cbde4a519dff74958c9b5acc9c9cb",
      "synthesisWallSeconds": 0.18272370810154825
    },
    {
      "factId": "product.format",
      "text": "本商品的规格选项只有电子版，请按电子资料使用。",
      "sourceSamples16k": 78136,
      "padSamples": 584,
      "paddedSamples": 78720,
      "durationSeconds": 4.92,
      "pcmSHA256": "213e9976f3d7b7e73168054dad4fe36a474163c47caad9e41b0f48fd270a7890",
      "synthesisWallSeconds": 0.1660834999056533
    },
    {
      "factId": "guide.01.05",
      "text": "这份指南讨论桌面整理方法，不提供实体收纳工具。",
      "sourceSamples16k": 82534,
      "padSamples": 26,
      "paddedSamples": 82560,
      "durationSeconds": 5.16,
      "pcmSHA256": "6efcf76a42bdeb2bb769f7b2bc476544c997cd945f0b80a72f8ec9cd51e3e295",
      "synthesisWallSeconds": 0.17913029191549867
    },
    {
      "factId": "guide.01.06",
      "text": "阅读时先选择最困扰你的桌面问题，再对应查找章节。",
      "sourceSamples16k": 80011,
      "padSamples": 629,
      "paddedSamples": 80640,
      "durationSeconds": 5.04,
      "pcmSHA256": "56bafae841faeb72ea49101903bbfc5ee0dfcf54cf2b7e653944e6f51c4f733f",
      "synthesisWallSeconds": 0.16840533295180649
    },
    {
      "factId": "guide.01.07",
      "text": "指南按照清空、分类、分区和维护，安排整理的步骤。",
      "sourceSamples16k": 78905,
      "padSamples": 455,
      "paddedSamples": 79360,
      "durationSeconds": 4.96,
      "pcmSHA256": "e6c6f9039c772be6e1327841a7746b71e5b27ef176bb5ca9f80842b33b9ac29d",
      "synthesisWallSeconds": 0.18486824992578477
    },
    {
      "factId": "guide.01.08",
      "text": "第一次实践可以先处理一小块区域，再逐步扩大范围。",
      "sourceSamples16k": 81083,
      "padSamples": 197,
      "paddedSamples": 81280,
      "durationSeconds": 5.08,
      "pcmSHA256": "87a9a8ab4396957c45d1dce94291e68641eeba7d0fe70565981177095a391582",
      "synthesisWallSeconds": 0.18295545794535428
    },
    {
      "factId": "guide.01.09",
      "text": "整理前请记录常见物品的位置，方便之后比较变化。",
      "sourceSamples16k": 77832,
      "padSamples": 248,
      "paddedSamples": 78080,
      "durationSeconds": 4.88,
      "pcmSHA256": "392171229c89b3f807b9003bbfeb4bf7299a563bd58bedd36a06c6621e2c7428",
      "synthesisWallSeconds": 0.17157004203181714
    },
    {
      "factId": "guide.01.10",
      "text": "每完成一个步骤都检查实际使用，避免只追求外观。",
      "sourceSamples16k": 80899,
      "padSamples": 381,
      "paddedSamples": 81280,
      "durationSeconds": 5.08,
      "pcmSHA256": "eb9bf0f4f02b26b4b303e975e64ac665ecc4eae6e427570bad53cff82e630adb",
      "synthesisWallSeconds": 0.17225816694553941
    },
    {
      "factId": "guide.02.01",
      "text": "开始整理之前先保存电脑工作，避免误动正在使用的物品。",
      "sourceSamples16k": 87990,
      "padSamples": 330,
      "paddedSamples": 88320,
      "durationSeconds": 5.52,
      "pcmSHA256": "ed2ac22c8e92b4e0b105b432f7613fb59c9d8a54fac9aa8114a3b8f0d59d13a4",
      "synthesisWallSeconds": 0.19146558304782957
    },
    {
      "factId": "guide.02.02",
      "text": "请准备一个临时收集盒，用来集中放置桌面上的散物。",
      "sourceSamples16k": 76909,
      "padSamples": 531,
      "paddedSamples": 77440,
      "durationSeconds": 4.84,
      "pcmSHA256": "ca98da362ea05d8a522e53b83c5b179a3b747cbfeea5df9fa0424bc1569655b1",
      "synthesisWallSeconds": 0.17399883398320526
    },
    {
      "factId": "guide.02.03",
      "text": "清空时先移走没有插电的轻小物品，减少碰倒的机会。",
      "sourceSamples16k": 79542,
      "padSamples": 458,
      "paddedSamples": 80000,
      "durationSeconds": 5.0,
      "pcmSHA256": "6b910bf232dd0fcc93e4640bf294c4df23b98c2ce54675987367be98d1dfbd0f",
      "synthesisWallSeconds": 0.17707829095888883
    },
    {
      "factId": "guide.02.04",
      "text": "有液体的杯子先盖好并移开，再处理旁边的纸张设备。",
      "sourceSamples16k": 77009,
      "padSamples": 431,
      "paddedSamples": 77440,
      "durationSeconds": 4.84,
      "pcmSHA256": "13f9dbad1ec4ad8b8808d46ce9fd5087e45aa70be368259d55881dfb49d1f7fa",
      "synthesisWallSeconds": 0.16728029202204198
    },
    {
      "factId": "guide.02.05",
      "text": "需要持续供电的设备先保留，不为整理强行拔掉电源。",
      "sourceSamples16k": 85165,
      "padSamples": 595,
      "paddedSamples": 85760,
      "durationSeconds": 5.36,
      "pcmSHA256": "fa92497ad1bb6a1fdfa411cf560b2f7efa2af3b2477eb1bd6dc06e741a6c2b23",
      "synthesisWallSeconds": 0.18351362505927682
    },
    {
      "factId": "guide.02.06",
      "text": "取下物品后用合适的清洁工具，擦去桌面的灰尘污渍。",
      "sourceSamples16k": 80858,
      "padSamples": 422,
      "paddedSamples": 81280,
      "durationSeconds": 5.08,
      "pcmSHA256": "f040c745f6aab59dc770cab2f9e051120acdbb34daa3a18be4a54dc7523b8238",
      "synthesisWallSeconds": 0.17967966699507087
    },
    {
      "factId": "guide.02.07",
      "text": "清洁桌面后等待表面干燥，再把电子设备放回原处。",
      "sourceSamples16k": 82918,
      "padSamples": 282,
      "paddedSamples": 83200,
      "durationSeconds": 5.2,
      "pcmSHA256": "fd0e0441407aa873891f4cece0c15a9fa67078b85c2e0df147275260b8dbb139",
      "synthesisWallSeconds": 0.1757237920537591
    },
    {
      "factId": "guide.02.08",
      "text": "暂时无法确定归属的物品，单独放进待判断的收集盒。",
      "sourceSamples16k": 81191,
      "padSamples": 89,
      "paddedSamples": 81280,
      "durationSeconds": 5.08,
      "pcmSHA256": "48c9baac54302e9371b6497eb3d51415512edb20c9eecf2d66103ccbead2ca31",
      "synthesisWallSeconds": 0.17246050003450364
    },
    {
      "factId": "guide.02.09",
      "text": "把明显的包装废料和垃圾移走，避免混入待整理物品。",
      "sourceSamples16k": 83882,
      "padSamples": 598,
      "paddedSamples": 84480,
      "durationSeconds": 5.28,
      "pcmSHA256": "ee4d1d2ae925bb7109975136a79eb037365bf88457680e684c410150d11efd97",
      "synthesisWallSeconds": 0.17905229108873755
    },
    {
      "factId": "guide.02.10",
      "text": "清空结束后拍下空桌面，记录能够实际使用的空间。",
      "sourceSamples16k": 80955,
      "padSamples": 325,
      "paddedSamples": 81280,
      "durationSeconds": 5.08,
      "pcmSHA256": "9cbfca4b8782b47423a7417e70504130d5a3e526f1f621ca6205480104b9ca03",
      "synthesisWallSeconds": 0.17208762501832098
    },
    {
      "factId": "guide.03.01",
      "text": "先按用途把桌面物品分开，区分工作、学习和生活用品。",
      "sourceSamples16k": 94123,
      "padSamples": 597,
      "paddedSamples": 94720,
      "durationSeconds": 5.92,
      "pcmSHA256": "473a6ecdba7989d998d1d13597f6dbd12dd4e97c05b14bdb1814e9e7b298ed6a",
      "synthesisWallSeconds": 0.2022564170183614
    },
    {
      "factId": "guide.03.02",
      "text": "每天都要使用的物品，归入经常取用的第一组类别。",
      "sourceSamples16k": 78546,
      "padSamples": 174,
      "paddedSamples": 78720,
      "durationSeconds": 4.92,
      "pcmSHA256": "9361176ef661a32fb5774d432a1093f036baec9d45bdd90c99025fc9968907ed",
      "synthesisWallSeconds": 0.17002654203679413
    },
    {
      "factId": "guide.03.03",
      "text": "每周偶尔才会用到的物品，归入低频取用的第二组。",
      "sourceSamples16k": 75877,
      "padSamples": 283,
      "paddedSamples": 76160,
      "durationSeconds": 4.76,
      "pcmSHA256": "4e38e0aba99387ab0a93a40f5162cca16acbcb4766da7bafbeb08a00480a2952",
      "synthesisWallSeconds": 0.1603522909572348
    },
    {
      "factId": "guide.03.04",
      "text": "长期没有使用而仍需保存的物品，另列为存档类别。",
      "sourceSamples16k": 86236,
      "padSamples": 164,
      "paddedSamples": 86400,
      "durationSeconds": 5.4,
      "pcmSHA256": "0cb8490002a997041099b046a2a631d396a71c2f38a11ea4413cfc2bad513c02",
      "synthesisWallSeconds": 0.17309391708113253
    },
    {
      "factId": "guide.03.05",
      "text": "同一种用途的物品先集中比较，再决定分别保留多少。",
      "sourceSamples16k": 80003,
      "padSamples": 637,
      "paddedSamples": 80640,
      "durationSeconds": 5.04,
      "pcmSHA256": "dca21a04cc02e499c1612fb457e27a5d01c5531650425ca1e2d0d2ffc1e719c8",
      "synthesisWallSeconds": 0.17834329197648913
    },
    {
      "factId": "guide.03.06",
      "text": "功能相同的重复物品，优先保留状态正常且容易使用的。",
      "sourceSamples16k": 84691,
      "padSamples": 429,
      "paddedSamples": 85120,
      "durationSeconds": 5.32,
      "pcmSHA256": "2d7883dc47cc0b14a6e11ed6acb8d9d912b9eda257d9061352b2e4c7ba3d9c54",
      "synthesisWallSeconds": 0.18365224997978657
    },
    {
      "factId": "guide.03.07",
      "text": "损坏物品单独标记待维修，避免再次混进正常用品里。",
      "sourceSamples16k": 89874,
      "padSamples": 366,
      "paddedSamples": 90240,
      "durationSeconds": 5.64,
      "pcmSHA256": "98a289e8dcab02cc1902b83d9f7aa747ec7277772213ade65e149b75054d6e5a",
      "synthesisWallSeconds": 0.18251245794817805
    },
    {
      "factId": "guide.03.08",
      "text": "属于其他房间的物品，放入归还区等待一次集中送回。",
      "sourceSamples16k": 85316,
      "padSamples": 444,
      "paddedSamples": 85760,
      "durationSeconds": 5.36,
      "pcmSHA256": "8d2e6e4cde555d26109718573e5caff38718c40ef8252bfb010ba3376c0cf8ea",
      "synthesisWallSeconds": 0.18152358394581825
    },
    {
      "factId": "guide.03.09",
      "text": "借来的物品记录借用来源，避免整理时误当个人物品。",
      "sourceSamples16k": 84263,
      "padSamples": 217,
      "paddedSamples": 84480,
      "durationSeconds": 5.28,
      "pcmSHA256": "238bec225841bd75b5a57706f4732a0a134640f326d04f4baf9667d3a72c804b",
      "synthesisWallSeconds": 0.17836845794226974
    },
    {
      "factId": "guide.03.10",
      "text": "分类结束后再安排容器，不先购买无法匹配物品的盒子。",
      "sourceSamples16k": 83055,
      "padSamples": 145,
      "paddedSamples": 83200,
      "durationSeconds": 5.2,
      "pcmSHA256": "7a669653ab2759783e11b87eba99767dfd6f3459c5db04026fbb9dae9ca87d20",
      "synthesisWallSeconds": 0.18541699997149408
    },
    {
      "factId": "guide.04.01",
      "text": "把桌面中央留给当前主要任务，保持一块连续工作区域。",
      "sourceSamples16k": 87442,
      "padSamples": 238,
      "paddedSamples": 87680,
      "durationSeconds": 5.48,
      "pcmSHA256": "313a487b2ba28a78e85991416d66d6c1d6d8fd8ef99b56b54ce95c770308bf4e",
      "synthesisWallSeconds": 0.17783916590269655
    },
    {
      "factId": "guide.04.02",
      "text": "经常伸手取用的物品，安排在坐姿下容易够到的位置。",
      "sourceSamples16k": 77362,
      "padSamples": 78,
      "paddedSamples": 77440,
      "durationSeconds": 4.84,
      "pcmSHA256": "beb613bfa290cd86b8304666a4dc0f2ab862dfcf0fc56f201f9398623bfa5cf9",
      "synthesisWallSeconds": 0.1748095409711823
    },
    {
      "factId": "guide.04.03",
      "text": "低频用品放在桌角或抽屉，不占用中央的主要操作区。",
      "sourceSamples16k": 79702,
      "padSamples": 298,
      "paddedSamples": 80000,
      "durationSeconds": 5.0,
      "pcmSHA256": "8c97560f2cdac5fa6bd59988c36d9aa16761fb4788a698f8f22bdfca6afbccd0",
      "synthesisWallSeconds": 0.17756020894739777
    },
    {
      "factId": "guide.04.04",
      "text": "屏幕附近留出稳定的放置区域，避免被临时物品挤歪。",
      "sourceSamples16k": 83095,
      "padSamples": 105,
      "paddedSamples": 83200,
      "durationSeconds": 5.2,
      "pcmSHA256": "e0a38fa484f9c7689c8e6052ba4f7985dd18c532291775284e838ce8f7baca11",
      "synthesisWallSeconds": 0.1848101249197498
    },
    {
      "factId": "guide.04.05",
      "text": "纸笔作业需要的区域，预留足够展开一本书的位置。",
      "sourceSamples16k": 79840,
      "padSamples": 160,
      "paddedSamples": 80000,
      "durationSeconds": 5.0,
      "pcmSHA256": "52c40972703deabb0b7fbdd3a59a7b289cf1a41a2a8a60353d431e5bbccb212c",
      "synthesisWallSeconds": 0.16611400002148002
    },
    {
      "factId": "guide.04.06",
      "text": "桌面照明的位置要结合惯用手，减少手部遮挡工作区。",
      "sourceSamples16k": 74597,
      "padSamples": 283,
      "paddedSamples": 74880,
      "durationSeconds": 4.68,
      "pcmSHA256": "36a392877131f8cce59a5e8830f02ebf1ed2d4130c1e58b832a9d60248233c29",
      "synthesisWallSeconds": 0.17235716595314443
    },
    {
      "factId": "guide.04.07",
      "text": "临时文件设置单独入口区，避免散落到整个桌面上。",
      "sourceSamples16k": 80100,
      "padSamples": 540,
      "paddedSamples": 80640,
      "durationSeconds": 5.04,
      "pcmSHA256": "7df9b2b4a55e3431981cfec8e8b2dd4dc98144b25fa87cadb0cf2731736b64f1",
      "synthesisWallSeconds": 0.1738171250326559
    },
    {
      "factId": "guide.04.08",
      "text": "已完成而待移走的物品，集中放在靠近出口的一侧。",
      "sourceSamples16k": 77872,
      "padSamples": 208,
      "paddedSamples": 78080,
      "durationSeconds": 4.88,
      "pcmSHA256": "21d2456fbe0f134d995287aec5f038e1fb8480fcb4de31ef4ff4912f5795bcf4",
      "synthesisWallSeconds": 0.16418745799455792
    },
    {
      "factId": "guide.04.09",
      "text": "不同分区之间保留取放通道，不把容器堆成连续障碍。",
      "sourceSamples16k": 83050,
      "padSamples": 150,
      "paddedSamples": 83200,
      "durationSeconds": 5.2,
      "pcmSHA256": "45ac99e64f6a9ec774ec4142ea1608137e9541408fc438bdd9f022511882b2d5",
      "synthesisWallSeconds": 0.1788842499954626
    },
    {
      "factId": "guide.04.10",
      "text": "分区完成后模拟一次工作流程，检查移动和取物是否顺畅。",
      "sourceSamples16k": 92021,
      "padSamples": 139,
      "paddedSamples": 92160,
      "durationSeconds": 5.76,
      "pcmSHA256": "7074068b58b8f67c3e3d57fe06ddec12881b087a3bb81df5a004ac8c701d229a",
      "synthesisWallSeconds": 0.20612904208246619
    },
    {
      "factId": "guide.05.01",
      "text": "先将桌面纸张按待处理、正在处理和已完成分成三组。",
      "sourceSamples16k": 83681,
      "padSamples": 159,
      "paddedSamples": 83840,
      "durationSeconds": 5.24,
      "pcmSHA256": "7bfa83087c9c8d2e77fa59e87cc9dcd28c184fc74999d7159baf0c0b14fc2736",
      "synthesisWallSeconds": 0.3402117909863591
    },
    {
      "factId": "guide.05.02",
      "text": "待处理文件只保留一个入口，避免多个位置重复积压。",
      "sourceSamples16k": 79216,
      "padSamples": 144,
      "paddedSamples": 79360,
      "durationSeconds": 4.96,
      "pcmSHA256": "4e8f55ed8d9ca52da3a780bc9780acd1d4bba8222c2127361252d776771a9172",
      "synthesisWallSeconds": 0.2480486249551177
    },
    {
      "factId": "guide.05.03",
      "text": "正在处理的文件放在独立文件夹里，便于结束时收起。",
      "sourceSamples16k": 81600,
      "padSamples": 320,
      "paddedSamples": 81920,
      "durationSeconds": 5.12,
      "pcmSHA256": "25e308d423e6e28e920d7c17dfdb6fd9ec028ab5a50d9b24d9b7c54b6f23f41e",
      "synthesisWallSeconds": 0.24805345793720335
    },
    {
      "factId": "guide.05.04",
      "text": "已经完成的资料按主题归档，不长期留在日常操作区。",
      "sourceSamples16k": 85973,
      "padSamples": 427,
      "paddedSamples": 86400,
      "durationSeconds": 5.4,
      "pcmSHA256": "de027eb369d04ef6730a900e588cb3cea9faa0fed3c1bb35c2e46101fceb8043",
      "synthesisWallSeconds": 0.2120787079911679
    },
    {
      "factId": "guide.05.05",
      "text": "重要原件和普通草稿分开放置，避免清理时一起丢弃。",
      "sourceSamples16k": 85559,
      "padSamples": 201,
      "paddedSamples": 85760,
      "durationSeconds": 5.36,
      "pcmSHA256": "3f345c947afaf040fef6465f5fdc8d45f9cbb4b80095211852be57adb61d1820",
      "synthesisWallSeconds": 0.18272925005294383
    },
    {
      "factId": "guide.05.06",
      "text": "纸张采用竖直或分层存放，避免底部内容被长期遮住。",
      "sourceSamples16k": 89875,
      "padSamples": 365,
      "paddedSamples": 90240,
      "durationSeconds": 5.64,
      "pcmSHA256": "2cdfde762bd8b1f345a9bc9c14f6d4d038072859e1a50a822b4faa4c82d6e47e",
      "synthesisWallSeconds": 0.1974484579404816
    },
    {
      "factId": "guide.05.07",
      "text": "为文件夹写上清晰主题标签，不只依靠颜色判断内容。",
      "sourceSamples16k": 87553,
      "padSamples": 127,
      "paddedSamples": 87680,
      "durationSeconds": 5.48,
      "pcmSHA256": "6e2da3a1f837b672df364ec93d6c8224e535072ad76536333740287c5fe1c98d",
      "synthesisWallSeconds": 0.1874527499312535
    },
    {
      "factId": "guide.05.08",
      "text": "同一项目的文件按日期排列，方便找到最近的一次修改。",
      "sourceSamples16k": 88510,
      "padSamples": 450,
      "paddedSamples": 88960,
      "durationSeconds": 5.56,
      "pcmSHA256": "a333d58049ad6fcf99e8341a2a9ae874ff3bd424c2d00aae73907f7b26b012ee",
      "synthesisWallSeconds": 0.19023133302107453
    },
    {
      "factId": "guide.05.09",
      "text": "需要销毁的敏感纸张单独处理，不直接混入公开废纸。",
      "sourceSamples16k": 86340,
      "padSamples": 60,
      "paddedSamples": 86400,
      "durationSeconds": 5.4,
      "pcmSHA256": "837f951250ca67e2f27272f428205bfca9d0ca804d04ee8afb74138f17d4fd7d",
      "synthesisWallSeconds": 0.19867170904763043
    },
    {
      "factId": "guide.05.10",
      "text": "定期检查待处理文件夹，给长时间未处理的资料安排去向。",
      "sourceSamples16k": 87405,
      "padSamples": 275,
      "paddedSamples": 87680,
      "durationSeconds": 5.48,
      "pcmSHA256": "f514634a42cd313aaff39bfa38506d48b71dcd8ca527754dedba258abffe09be",
      "synthesisWallSeconds": 0.19904954102821648
    },
    {
      "factId": "guide.06.01",
      "text": "整理线缆之前先确认用途，避免拔掉正在传输数据的连接。",
      "sourceSamples16k": 91607,
      "padSamples": 553,
      "paddedSamples": 92160,
      "durationSeconds": 5.76,
      "pcmSHA256": "68c5eb7480c43d12a995cc584e219534ff9f40200b12f54c49ba3a0cb031902b",
      "synthesisWallSeconds": 0.20328220899682492
    },
    {
      "factId": "guide.06.02",
      "text": "按照电源线、数据线和备用线分类，减少寻找时的混乱。",
      "sourceSamples16k": 85013,
      "padSamples": 107,
      "paddedSamples": 85120,
      "durationSeconds": 5.32,
      "pcmSHA256": "b9e5e3324ef9119a79fd1706110fde165eaa7d58d87960a90ff3a661d8e8cd84",
      "synthesisWallSeconds": 0.19345400005113333
    },
    {
      "factId": "guide.06.03",
      "text": "常用充电线在固定位置收好，避免每次从桌后摸索。",
      "sourceSamples16k": 83698,
      "padSamples": 142,
      "paddedSamples": 83840,
      "durationSeconds": 5.24,
      "pcmSHA256": "a99cc4e8a21e52dc22fca00f3dbfd2fe7ce340bb4a218ce85dda80ffcdb3b539",
      "synthesisWallSeconds": 0.1865922079887241
    },
    {
      "factId": "guide.06.04",
      "text": "线缆保留必要的活动余量，不拉紧设备附近的接口。",
      "sourceSamples16k": 73227,
      "padSamples": 373,
      "paddedSamples": 73600,
      "durationSeconds": 4.6,
      "pcmSHA256": "62cd6251cde701dfe9f6141f86aa4fab53793efccce56f38c0a8f981e9a28fd6",
      "synthesisWallSeconds": 0.17119129200000316
    },
    {
      "factId": "guide.06.05",
      "text": "多余长度可以松散固定，不把线缆折成明显的锐角。",
      "sourceSamples16k": 79010,
      "padSamples": 350,
      "paddedSamples": 79360,
      "durationSeconds": 4.96,
      "pcmSHA256": "7d5fca09708d90ae283a2df0fcb4991e2ee7782e949c15de3b98d3bb787af223",
      "synthesisWallSeconds": 0.17383891704957932
    },
    {
      "factId": "guide.06.06",
      "text": "为相似的线缆标记对应设备，避免反复试插辨认用途。",
      "sourceSamples16k": 86757,
      "padSamples": 283,
      "paddedSamples": 87040,
      "durationSeconds": 5.44,
      "pcmSHA256": "1b31b05568102c659735aafe51e1ee68ac378d7abd9d03babca52128a94c2c1c",
      "synthesisWallSeconds": 0.1877334580058232
    },
    {
      "factId": "guide.06.07",
      "text": "电源插座周围留出查看空间，不被纸张和杂物完全覆盖。",
      "sourceSamples16k": 91048,
      "padSamples": 472,
      "paddedSamples": 91520,
      "durationSeconds": 5.72,
      "pcmSHA256": "c05173450aa60f7077b8c0fdeddb843a475edb74bd00875bd603e5242433aac0",
      "synthesisWallSeconds": 0.1874596249544993
    },
    {
      "factId": "guide.06.08",
      "text": "发现破损或裸露的线缆先停止使用，再安排更换处理。",
      "sourceSamples16k": 83443,
      "padSamples": 397,
      "paddedSamples": 83840,
      "durationSeconds": 5.24,
      "pcmSHA256": "f6367bd1b2120efae6e66edcbaed1fa0edcf4dc2aede78c91ceddbda9455b00c",
      "synthesisWallSeconds": 0.1861196659738198
    },
    {
      "factId": "guide.06.09",
      "text": "备用线缆集中放入小袋，不与每天使用的连接线混放。",
      "sourceSamples16k": 78577,
      "padSamples": 143,
      "paddedSamples": 78720,
      "durationSeconds": 4.92,
      "pcmSHA256": "ec96f1d7ba0b4a6e16ad96908791a1462016e65c47a3009d707c7353a9c1a8ca",
      "synthesisWallSeconds": 0.17709300003480166
    },
    {
      "factId": "guide.06.10",
      "text": "清洁线缆周围时避免洒水，先按设备要求做好断电处理。",
      "sourceSamples16k": 90186,
      "padSamples": 54,
      "paddedSamples": 90240,
      "durationSeconds": 5.64,
      "pcmSHA256": "5745ab12204d128c0bd348de1e55a50c7cfdf1dde4cdb6c128f040b2071b9275",
      "synthesisWallSeconds": 0.19000999990385026
    },
    {
      "factId": "guide.07.01",
      "text": "把经常使用的笔集中在一个笔筒，避免分散占据桌面。",
      "sourceSamples16k": 84674,
      "padSamples": 446,
      "paddedSamples": 85120,
      "durationSeconds": 5.32,
      "pcmSHA256": "a393c23b74c95bae8c3b0f3b8c8d5dfc335fbc822dda6060a7e6f2ea3cc9083d",
      "synthesisWallSeconds": 0.17710637499112636
    },
    {
      "factId": "guide.07.02",
      "text": "先试写并区分笔的状态，再决定哪些需要补充或丢弃。",
      "sourceSamples16k": 83270,
      "padSamples": 570,
      "paddedSamples": 83840,
      "durationSeconds": 5.24,
      "pcmSHA256": "c9c1b7d571706f3098e6197406f0ea8811cc1ece469b17005b7907a42da1cdbd",
      "synthesisWallSeconds": 0.18377912498544902
    },
    {
      "factId": "guide.07.03",
      "text": "尺子和剪刀安排独立位置，避免夹在文件堆中难以找到。",
      "sourceSamples16k": 91854,
      "padSamples": 306,
      "paddedSamples": 92160,
      "durationSeconds": 5.76,
      "pcmSHA256": "9773ff616f13a043b23cf1e0835fd627e05cbbe500bcf854e10dbb13552f1883",
      "synthesisWallSeconds": 0.18904199998360127
    },
    {
      "factId": "guide.07.04",
      "text": "锋利工具存放时收好刀刃，不朝向日常伸手取物的方向。",
      "sourceSamples16k": 86549,
      "padSamples": 491,
      "paddedSamples": 87040,
      "durationSeconds": 5.44,
      "pcmSHA256": "a6110d86feadb9e89fc13bbf2cf2d4ca17d6ad9ba87f2042e008674d1575c7d3",
      "synthesisWallSeconds": 0.18276658304966986
    },
    {
      "factId": "guide.07.05",
      "text": "便签纸和索引贴放在同一分区，方便记录与标记配合使用。",
      "sourceSamples16k": 94963,
      "padSamples": 397,
      "paddedSamples": 95360,
      "durationSeconds": 5.96,
      "pcmSHA256": "9786b7f23168bd23c16db78b7816c0229359c05c6f99d211bd621001d0290f94",
      "synthesisWallSeconds": 0.204476417042315
    },
    {
      "factId": "guide.07.06",
      "text": "容易散开的回形针使用小格容器，不直接倒在抽屉底部。",
      "sourceSamples16k": 78993,
      "padSamples": 367,
      "paddedSamples": 79360,
      "durationSeconds": 4.96,
      "pcmSHA256": "6e5e97005f572810beb3e0db0c51f51436c2634f9a4fc0a4027ca54f96cdd29a",
      "synthesisWallSeconds": 0.1772828329121694
    },
    {
      "factId": "guide.07.07",
      "text": "备用文具和正在使用的文具分开，避免每种都摆上桌面。",
      "sourceSamples16k": 85606,
      "padSamples": 154,
      "paddedSamples": 85760,
      "durationSeconds": 5.36,
      "pcmSHA256": "ad399979c6ed426ff6aaec1cbeba0272198c37c4f0cf4670fd8e669cd46a3199",
      "synthesisWallSeconds": 0.1821329580852762
    },
    {
      "factId": "guide.07.08",
      "text": "胶带和胶水检查盖口是否闭合，减少黏连附近物品的情况。",
      "sourceSamples16k": 82657,
      "padSamples": 543,
      "paddedSamples": 83200,
      "durationSeconds": 5.2,
      "pcmSHA256": "80652ed10686bfbc6e83bb99ace17c6013496f564765fbe3c4f6e4351e8ddc9a",
      "synthesisWallSeconds": 0.18402074999175966
    },
    {
      "factId": "guide.07.09",
      "text": "体积较大的工具收进抽屉，只有使用时才放到操作区。",
      "sourceSamples16k": 78150,
      "padSamples": 570,
      "paddedSamples": 78720,
      "durationSeconds": 4.92,
      "pcmSHA256": "1930ee233eddbe9946a0501601986606467856a38a0bf4ef9ad2c0d949fc9a51",
      "synthesisWallSeconds": 0.1745129170594737
    },
    {
      "factId": "guide.07.10",
      "text": "选择容器时检查实际拿取动作，避免收得整齐却难以取出。",
      "sourceSamples16k": 91706,
      "padSamples": 454,
      "paddedSamples": 92160,
      "durationSeconds": 5.76,
      "pcmSHA256": "b3ca0fca1fa884a16e50a4dce8dbb8dac6cf505b1fcc5a5964b37708427a49e6",
      "synthesisWallSeconds": 0.19566924998071045
    },
    {
      "factId": "guide.08.01",
      "text": "钥匙等出门必需的小物，设置一个固定的临时放置位置。",
      "sourceSamples16k": 81362,
      "padSamples": 558,
      "paddedSamples": 81920,
      "durationSeconds": 5.12,
      "pcmSHA256": "ec85ec65e0829ed591d754f9020dfe42add32229e476847c2738e2de54fd7850",
      "synthesisWallSeconds": 0.18220266699790955
    },
    {
      "factId": "guide.08.02",
      "text": "抽屉先清空并查看内部尺寸，再选择适合的分隔方式。",
      "sourceSamples16k": 79005,
      "padSamples": 355,
      "paddedSamples": 79360,
      "durationSeconds": 4.96,
      "pcmSHA256": "82e02fa157e25862effc73091a945c88698b077724c578c04143a5c972881982",
      "synthesisWallSeconds": 0.17231850000098348
    },
    {
      "factId": "guide.08.03",
      "text": "浅层抽屉放低矮物品，避免关闭时被突出的物品卡住。",
      "sourceSamples16k": 83051,
      "padSamples": 149,
      "paddedSamples": 83200,
      "durationSeconds": 5.2,
      "pcmSHA256": "a72e9c8fd997363c76e7f4f0b1b767292ec5721b00f86a186df1c512742e3453",
      "synthesisWallSeconds": 0.17647458403371274
    },
    {
      "factId": "guide.08.04",
      "text": "深层抽屉用分格区分种类，不把不同小物全部堆在一起。",
      "sourceSamples16k": 79685,
      "padSamples": 315,
      "paddedSamples": 80000,
      "durationSeconds": 5.0,
      "pcmSHA256": "1ce42db619cc3b7f94cf48876db512b3878ac0e0c55f271d801ee93cb7c82091",
      "synthesisWallSeconds": 0.16912741702981293
    },
    {
      "factId": "guide.08.05",
      "text": "同类物品的容器保留一点余量，方便放回而不必重新排满。",
      "sourceSamples16k": 92393,
      "padSamples": 407,
      "paddedSamples": 92800,
      "durationSeconds": 5.8,
      "pcmSHA256": "057e5b019f135fadef1640fe3145204d0288c87528c637822edfae8939f15181",
      "synthesisWallSeconds": 0.2011653329245746
    },
    {
      "factId": "guide.08.06",
      "text": "容易滚动的小物用有边缘的容器，减少开关抽屉时移动。",
      "sourceSamples16k": 86832,
      "padSamples": 208,
      "paddedSamples": 87040,
      "durationSeconds": 5.44,
      "pcmSHA256": "1d153137435d88ad1e415a0ed642d15198519f189fcebc7d8581923dc523cabf",
      "synthesisWallSeconds": 0.18850208295043558
    },
    {
      "factId": "guide.08.07",
      "text": "暂时需要保管的票据设一个位置，不夹进随机书页里。",
      "sourceSamples16k": 81150,
      "padSamples": 130,
      "paddedSamples": 81280,
      "durationSeconds": 5.08,
      "pcmSHA256": "b3f858ab85d014c93b7936c92c5dfed065defd9b51d70b07a26a720fdfe5cf1e",
      "synthesisWallSeconds": 0.18444237497169524
    },
    {
      "factId": "guide.08.08",
      "text": "需要成套使用的配件放在一起，并在容器上注明对应用途。",
      "sourceSamples16k": 87407,
      "padSamples": 273,
      "paddedSamples": 87680,
      "durationSeconds": 5.48,
      "pcmSHA256": "ca259278bf3f0202efd0862e0d3216bfa09d2228ba0708eb7a65461d9b5569b1",
      "synthesisWallSeconds": 0.20377099991310388
    },
    {
      "factId": "guide.08.09",
      "text": "每个抽屉只安排明确的功能，避免重新成为杂物的汇集处。",
      "sourceSamples16k": 87215,
      "padSamples": 465,
      "paddedSamples": 87680,
      "durationSeconds": 5.48,
      "pcmSHA256": "6ad04cea16091c8cc6216977cdcac55b32fac8e68eb264f79d6967c329a4ed61",
      "synthesisWallSeconds": 0.18572495796252042
    },
    {
      "factId": "guide.08.10",
      "text": "抽屉标签放在容易看见的位置，帮助使用后快速归还物品。",
      "sourceSamples16k": 86396,
      "padSamples": 4,
      "paddedSamples": 86400,
      "durationSeconds": 5.4,
      "pcmSHA256": "00c3b878d27b0867fb4ff4c9b1bfcf25e5d26dad6dde586586e56f5ec64a5325",
      "synthesisWallSeconds": 0.18623137508984655
    },
    {
      "factId": "guide.09.01",
      "text": "电脑桌面的文件按用途分组，避免用大量图标代替文件夹。",
      "sourceSamples16k": 90095,
      "padSamples": 145,
      "paddedSamples": 90240,
      "durationSeconds": 5.64,
      "pcmSHA256": "f083ea6c7d5d24e5f503af584e74b9c65c7c0a544bc7bd72bffba9722278c413",
      "synthesisWallSeconds": 0.2093900420004502
    },
    {
      "factId": "guide.09.02",
      "text": "文件名称写明主题和日期，减少依靠反复打开进行辨认。",
      "sourceSamples16k": 87382,
      "padSamples": 298,
      "paddedSamples": 87680,
      "durationSeconds": 5.48,
      "pcmSHA256": "e0a2c4470e154ff88d71e4d84efc2c222a3439ff46f67bbc4a597e4ad06ef576",
      "synthesisWallSeconds": 0.20459154096897691
    },
    {
      "factId": "guide.09.03",
      "text": "同一项目的电子资料放入固定目录，减少不同路径的副本。",
      "sourceSamples16k": 88290,
      "padSamples": 30,
      "paddedSamples": 88320,
      "durationSeconds": 5.52,
      "pcmSHA256": "70ebfc6085673dda85f606308ce35b196de87ab5e1c83639afa28b8f3b21f14c",
      "synthesisWallSeconds": 0.20814520795829594
    },
    {
      "factId": "guide.09.04",
      "text": "未完成文件与已归档文件分开，避免覆盖正在处理的版本。",
      "sourceSamples16k": 88855,
      "padSamples": 105,
      "paddedSamples": 88960,
      "durationSeconds": 5.56,
      "pcmSHA256": "6ae21fed2ecfdc9c2be50f7b529c36a8ecedae1ea4fa827e6922bc9f9259ea96",
      "synthesisWallSeconds": 0.23281145805958658
    },
    {
      "factId": "guide.09.05",
      "text": "下载目录定期检查归属，不把临时文件长期当作正式存档。",
      "sourceSamples16k": 89796,
      "padSamples": 444,
      "paddedSamples": 90240,
      "durationSeconds": 5.64,
      "pcmSHA256": "d31cf303005576e31130d9e9a9f7a899d0ae45bed79d621b223735411d968971",
      "synthesisWallSeconds": 0.21616312500555068
    },
    {
      "factId": "guide.09.06",
      "text": "需要备份的重要资料按既定规则保存，不只留在桌面文件夹。",
      "sourceSamples16k": 87889,
      "padSamples": 431,
      "paddedSamples": 88320,
      "durationSeconds": 5.52,
      "pcmSHA256": "53fb3523ad44d8330bc8de9deac0e2eed237c19c4b87853f9bf1c5729e0b6bc9",
      "synthesisWallSeconds": 0.22390862496104091
    },
    {
      "factId": "guide.09.07",
      "text": "整理电子文件前确认备份情况，避免误删唯一的一份资料。",
      "sourceSamples16k": 90079,
      "padSamples": 161,
      "paddedSamples": 90240,
      "durationSeconds": 5.64,
      "pcmSHA256": "be9ae2bbe427899dd12abcd36be0926d380c8ab65282b7b2e332c0c0d02c0a0b",
      "synthesisWallSeconds": 0.21753070806153119
    },
    {
      "factId": "guide.09.08",
      "text": "快捷方式只保留经常使用的入口，不让界面再次堆满图标。",
      "sourceSamples16k": 89333,
      "padSamples": 267,
      "paddedSamples": 89600,
      "durationSeconds": 5.6,
      "pcmSHA256": "ca7f0010d24cbecc38a0218019e03184acfe3da2c2fe344de978cae249ad5fcc",
      "synthesisWallSeconds": 0.19789129204582423
    },
    {
      "factId": "guide.09.09",
      "text": "截图按主题及时归入目录，避免只凭自动编号寻找内容。",
      "sourceSamples16k": 87970,
      "padSamples": 350,
      "paddedSamples": 88320,
      "durationSeconds": 5.52,
      "pcmSHA256": "4494dc928878159a2adb43190e3aa6b71c3013310c7cf78ac722d6762c3c1219",
      "synthesisWallSeconds": 0.22693091700784862
    },
    {
      "factId": "guide.09.10",
      "text": "共享资料与私人资料分开存放，发布前检查访问权限范围。",
      "sourceSamples16k": 91416,
      "padSamples": 104,
      "paddedSamples": 91520,
      "durationSeconds": 5.72,
      "pcmSHA256": "ce769765284355752b71acca1d59625866cfb9e2b071900787e527ee96bf0b4a",
      "synthesisWallSeconds": 0.21591383300255984
    },
    {
      "factId": "guide.10.01",
      "text": "每天结束工作时先保存当前进度，再收起正在使用的资料。",
      "sourceSamples16k": 87815,
      "padSamples": 505,
      "paddedSamples": 88320,
      "durationSeconds": 5.52,
      "pcmSHA256": "0a6790b50f66d65815b483d49d8d440dc64e8f1a1a71574dce1415cd989fdc81",
      "synthesisWallSeconds": 0.1934221249539405
    },
    {
      "factId": "guide.10.02",
      "text": "使用过的笔和工具放回固定位置，不留给下一次开工处理。",
      "sourceSamples16k": 86587,
      "padSamples": 453,
      "paddedSamples": 87040,
      "durationSeconds": 5.44,
      "pcmSHA256": "31df146fde6a5b836750fbff0ec5959432ffdb30bb44aa3092198feebc8c83c1",
      "synthesisWallSeconds": 0.1929361670045182
    },
    {
      "factId": "guide.10.03",
      "text": "桌面上的空杯和食物包装当天移走，避免变成长期杂物。",
      "sourceSamples16k": 89505,
      "padSamples": 95,
      "paddedSamples": 89600,
      "durationSeconds": 5.6,
      "pcmSHA256": "87f2b20b04578b5cba92f97ab1391dd74539bcebff13f88fa47f799137f8210a",
      "synthesisWallSeconds": 0.195758540998213
    },
    {
      "factId": "guide.10.04",
      "text": "把第二天需要继续的资料集中摆放，方便再次开始任务。",
      "sourceSamples16k": 87055,
      "padSamples": 625,
      "paddedSamples": 87680,
      "durationSeconds": 5.48,
      "pcmSHA256": "d536484eff4df7d61235ac037cc33480dd758fa94ca0ed3909ff0d79180d21e2",
      "synthesisWallSeconds": 0.18761799996718764
    },
    {
      "factId": "guide.10.05",
      "text": "只为明天准备必要用品，不把所有备用物品都搬回桌面。",
      "sourceSamples16k": 87337,
      "padSamples": 343,
      "paddedSamples": 87680,
      "durationSeconds": 5.48,
      "pcmSHA256": "8035c5b91d961ab57866f421d189cea14faf3c548408d75e711601207c75a7a4",
      "synthesisWallSeconds": 0.1988506669877097
    },
    {
      "factId": "guide.10.06",
      "text": "离开座位前查看充电和设备状态，按实际需要关闭电源。",
      "sourceSamples16k": 85647,
      "padSamples": 113,
      "paddedSamples": 85760,
      "durationSeconds": 5.36,
      "pcmSHA256": "df7c6bd13d31c77ea62df400ca1a30bd1d61710ee108a9523294f9bf29639f27",
      "synthesisWallSeconds": 0.18285929202102125
    },
    {
      "factId": "guide.10.07",
      "text": "收尾时检查中央工作区域，确认没有被临时物品占满。",
      "sourceSamples16k": 85593,
      "padSamples": 167,
      "paddedSamples": 85760,
      "durationSeconds": 5.36,
      "pcmSHA256": "a423616c0fe5ca3da5dbcf97974392d538478ea55d693ac61ca8598358340c1c",
      "synthesisWallSeconds": 0.17857216601260006
    },
    {
      "factId": "guide.10.08",
      "text": "遇到不属于自己的物品，及时归还而不是继续留在手边。",
      "sourceSamples16k": 82367,
      "padSamples": 193,
      "paddedSamples": 82560,
      "durationSeconds": 5.16,
      "pcmSHA256": "1d64494f16c653c89b4dc9fa3382cc0cfd25d396b766929979252a4e337b6b7c",
      "synthesisWallSeconds": 0.18011387495789677
    },
    {
      "factId": "guide.10.09",
      "text": "给临时收集盒安排清理时间，避免它变成长期积压的角落。",
      "sourceSamples16k": 84873,
      "padSamples": 247,
      "paddedSamples": 85120,
      "durationSeconds": 5.32,
      "pcmSHA256": "b4e13a2b4c9bfbb4bdab010be9a98a5bf3f1cc60bd113bceb3c7793d725c40d7",
      "synthesisWallSeconds": 0.18842424999456853
    },
    {
      "factId": "guide.10.10",
      "text": "每日收尾完成后保留一个简短记录，方便观察维护是否持续。",
      "sourceSamples16k": 88843,
      "padSamples": 117,
      "paddedSamples": 88960,
      "durationSeconds": 5.56,
      "pcmSHA256": "20989467a947ded81cc16d9472c9229510addffd84afe6e337e7ee3b683d78d0",
      "synthesisWallSeconds": 0.1939264590619132
    },
    {
      "factId": "guide.11.01",
      "text": "桌面空间有限时优先满足主要任务，不同时展开所有活动。",
      "sourceSamples16k": 95120,
      "padSamples": 240,
      "paddedSamples": 95360,
      "durationSeconds": 5.96,
      "pcmSHA256": "e9e3739bed24a90ff3cc1f2d5cff4cef3b9e7a7bbe99856e8bcbf24909dcb866",
      "synthesisWallSeconds": 0.1931892909342423
    },
    {
      "factId": "guide.11.02",
      "text": "把低频用品移到其他储存位置，给高频操作留出必要空间。",
      "sourceSamples16k": 97947,
      "padSamples": 613,
      "paddedSamples": 98560,
      "durationSeconds": 6.16,
      "pcmSHA256": "e6d44cd8f9c77535020e598bd31c885a1c75ebeed6c0942a70db9ca89ed19484",
      "synthesisWallSeconds": 0.20162245794199407
    },
    {
      "factId": "guide.11.03",
      "text": "使用竖直文件架时确认底座稳固，避免取纸时整体倾倒。",
      "sourceSamples16k": 87498,
      "padSamples": 182,
      "paddedSamples": 87680,
      "durationSeconds": 5.48,
      "pcmSHA256": "222eb47af90562e11d5673a0f34ead04382baae1a9fdf68fd5e075e8a034e1a6",
      "synthesisWallSeconds": 0.18570041691418737
    },
    {
      "factId": "guide.11.04",
      "text": "可移动的小托盘适合集中用品，切换任务时能一次收起。",
      "sourceSamples16k": 82367,
      "padSamples": 193,
      "paddedSamples": 82560,
      "durationSeconds": 5.16,
      "pcmSHA256": "538a2745807cbc1231d76b21db8d7870489b122f7d58f26816df7719416d7408",
      "synthesisWallSeconds": 0.18700745794922113
    },
    {
      "factId": "guide.11.05",
      "text": "经常变换座位时准备轻便收纳袋，减少携带多余的小工具。",
      "sourceSamples16k": 81524,
      "padSamples": 396,
      "paddedSamples": 81920,
      "durationSeconds": 5.12,
      "pcmSHA256": "f5d2d5eb13c322d9ebe8caafcab30a979c0bfc54576af1367c3c6941d08b8c1e",
      "synthesisWallSeconds": 0.18329445901326835
    },
    {
      "factId": "guide.11.06",
      "text": "移动用品按使用顺序放置，避免每次需要把整个袋子倒空。",
      "sourceSamples16k": 88479,
      "padSamples": 481,
      "paddedSamples": 88960,
      "durationSeconds": 5.56,
      "pcmSHA256": "4e2b5e3ed7a8319dc14175eb215e0eed6de1f79704accf0b4983c6b106e9347b",
      "synthesisWallSeconds": 0.19306837499607354
    },
    {
      "factId": "guide.11.07",
      "text": "临时桌面也先划出工作区域，不将所有随身物品铺满。",
      "sourceSamples16k": 84109,
      "padSamples": 371,
      "paddedSamples": 84480,
      "durationSeconds": 5.28,
      "pcmSHA256": "906bd395f08f39daf3dee4a9daec034ddac132ccfc03f2759db9aa3665976cb2",
      "synthesisWallSeconds": 0.18081208399962634
    },
    {
      "factId": "guide.11.08",
      "text": "离开临时座位前检查插线和小物，避免遗忘正在使用的配件。",
      "sourceSamples16k": 88672,
      "padSamples": 288,
      "paddedSamples": 88960,
      "durationSeconds": 5.56,
      "pcmSHA256": "0fbc96f04025262cf8efbcfc2a2b653c58b48e3911561b1eae07e9801f5a6348",
      "synthesisWallSeconds": 0.19247358397115022
    },
    {
      "factId": "guide.11.09",
      "text": "折叠或移动桌面前先收起设备，避免物品滑落造成损坏。",
      "sourceSamples16k": 88084,
      "padSamples": 236,
      "paddedSamples": 88320,
      "durationSeconds": 5.52,
      "pcmSHA256": "1b1631564e77ae3dab9881469b83c9fa276f8abac7ee8d896471fefa67dcfc69",
      "synthesisWallSeconds": 0.1930816660169512
    },
    {
      "factId": "guide.11.10",
      "text": "空间布局改变之后重新检查取物距离，不照搬原来的分区。",
      "sourceSamples16k": 87535,
      "padSamples": 145,
      "paddedSamples": 87680,
      "durationSeconds": 5.48,
      "pcmSHA256": "a944b1c19a5fdc4b9d70f9be48d806faa102b5b57fb68434e376dd2672767b0a",
      "synthesisWallSeconds": 0.19136987498495728
    },
    {
      "factId": "guide.12.01",
      "text": "多人共用桌面时先约定公共区域，不让个人用品长期占用。",
      "sourceSamples16k": 88056,
      "padSamples": 264,
      "paddedSamples": 88320,
      "durationSeconds": 5.52,
      "pcmSHA256": "922de72247e2fc34c7eff98770831c7a30057955e83c78ca24f47b4ab0b03340",
      "synthesisWallSeconds": 0.2093595420010388
    },
    {
      "factId": "guide.12.02",
      "text": "公共工具和私人文具分开标记，方便使用后归还正确位置。",
      "sourceSamples16k": 89034,
      "padSamples": 566,
      "paddedSamples": 89600,
      "durationSeconds": 5.6,
      "pcmSHA256": "1769f158d9de265ce8e3bd55962a42a325fe9c9b2ab5a2c1c3a65039e4bd0930",
      "synthesisWallSeconds": 0.19101287494413555
    },
    {
      "factId": "guide.12.03",
      "text": "共享文件设定统一的放置规则，避免每个人另开一个入口。",
      "sourceSamples16k": 85694,
      "padSamples": 66,
      "paddedSamples": 85760,
      "durationSeconds": 5.36,
      "pcmSHA256": "a1b2c0be58e428019dae7b35828b587f52dfe114d77a2a2cfe3eb9a9e1791fac",
      "synthesisWallSeconds": 0.1775393330026418
    },
    {
      "factId": "guide.12.04",
      "text": "借用工具前确认使用安排，不打断他人正在进行的任务。",
      "sourceSamples16k": 84167,
      "padSamples": 313,
      "paddedSamples": 84480,
      "durationSeconds": 5.28,
      "pcmSHA256": "c0e8bf78429cb3e05b5d0f33a58c5e89938aa2c225647cbcdeaccfc750c2b41d",
      "synthesisWallSeconds": 0.17763116699643433
    },
    {
      "factId": "guide.12.05",
      "text": "使用完公共设备后恢复约定状态，给下一位使用者留出空间。",
      "sourceSamples16k": 92250,
      "padSamples": 550,
      "paddedSamples": 92800,
      "durationSeconds": 5.8,
      "pcmSHA256": "21273587f5ff1ce9717dbe62eede411c3e79b45fe5d444363da71a989f22b6d5",
      "synthesisWallSeconds": 0.19305070803966373
    },
    {
      "factId": "guide.12.06",
      "text": "临时改变桌面布局时说明原因，避免其他人找不到原有物品。",
      "sourceSamples16k": 84887,
      "padSamples": 233,
      "paddedSamples": 85120,
      "durationSeconds": 5.32,
      "pcmSHA256": "fba5d5bd38c428f56338c953ccad7068197227fe84fe15015d8876c24dc5a1cf",
      "synthesisWallSeconds": 0.19155104202218354
    },
    {
      "factId": "guide.12.07",
      "text": "公共区域的垃圾及时清理，不把维护责任留给最后一个人。",
      "sourceSamples16k": 88521,
      "padSamples": 439,
      "paddedSamples": 88960,
      "durationSeconds": 5.56,
      "pcmSHA256": "710985f9cb0f20f41805373a78a534c3018c657e98d827b5420fbae1c9fa7728",
      "synthesisWallSeconds": 0.21386895910836756
    },
    {
      "factId": "guide.12.08",
      "text": "共享收纳位置采用清楚的标签，减少仅凭个人习惯判断归属。",
      "sourceSamples16k": 98055,
      "padSamples": 505,
      "paddedSamples": 98560,
      "durationSeconds": 6.16,
      "pcmSHA256": "25bbe8045c9e9d374f419379099f57d647d12481798b7f15f736f589cfe8e5f2",
      "synthesisWallSeconds": 0.24388762505259365
    },
    {
      "factId": "guide.12.09",
      "text": "涉及私密资料时先收好内容，不直接留在多人可见的桌面。",
      "sourceSamples16k": 86797,
      "padSamples": 243,
      "paddedSamples": 87040,
      "durationSeconds": 5.44,
      "pcmSHA256": "f1cd30bc7db58025061778fa3039d43ac4b7f47af3b6af6d1ee2f353e82ac9e4",
      "synthesisWallSeconds": 0.18943095894064754
    },
    {
      "factId": "guide.12.10",
      "text": "共同讨论哪些物品确实需要常驻，减少公共区域的重复堆放。",
      "sourceSamples16k": 92320,
      "padSamples": 480,
      "paddedSamples": 92800,
      "durationSeconds": 5.8,
      "pcmSHA256": "941ed017379ff18a25f1735a3e1f54c5ebaf98b13c1bb67bb0a103de427b01be",
      "synthesisWallSeconds": 0.20160104194656014
    },
    {
      "factId": "guide.13.01",
      "text": "每周查看一次分区状态，找出最容易重新堆积物品的位置。",
      "sourceSamples16k": 89571,
      "padSamples": 29,
      "paddedSamples": 89600,
      "durationSeconds": 5.6,
      "pcmSHA256": "ce8a19c5871cd28d77fedc948d5691726b18d8ed6c401b7de609cd55fe7cecf9",
      "synthesisWallSeconds": 0.18747574998997152
    },
    {
      "factId": "guide.13.02",
      "text": "检查收纳盒里是否出现无关物品，及时恢复原定用途范围。",
      "sourceSamples16k": 87554,
      "padSamples": 126,
      "paddedSamples": 87680,
      "durationSeconds": 5.48,
      "pcmSHA256": "f15b4bbc0c55166e5afa274779770e13261daf9e5689c70bf4a157379675a82e",
      "synthesisWallSeconds": 0.18962045898661017
    },
    {
      "factId": "guide.13.03",
      "text": "观察设备散热区域是否被遮挡，不用文件夹包围排风位置。",
      "sourceSamples16k": 89296,
      "padSamples": 304,
      "paddedSamples": 89600,
      "durationSeconds": 5.6,
      "pcmSHA256": "9e313ff325ce962d78f8f41ed84e4a0d87a03a7d7eaa9a86baef41808f20a2ad",
      "synthesisWallSeconds": 0.18761766597162932
    },
    {
      "factId": "guide.13.04",
      "text": "检查桌边物品是否稳固，避免常用操作把它们推到边缘。",
      "sourceSamples16k": 95282,
      "padSamples": 78,
      "paddedSamples": 95360,
      "durationSeconds": 5.96,
      "pcmSHA256": "0a3c12fa1d239b3bfe54574f79e08dc69e838aa019a80b2271eee3798473a61c",
      "synthesisWallSeconds": 0.19709066697396338
    },
    {
      "factId": "guide.13.05",
      "text": "发现容器破损或尖锐边角，先停止使用并更换合适的容器。",
      "sourceSamples16k": 93392,
      "padSamples": 48,
      "paddedSamples": 93440,
      "durationSeconds": 5.84,
      "pcmSHA256": "461729b0c5826fac1a835f4d5397cc70653c6a7353bc4c41cacc0b5c08ac249c",
      "synthesisWallSeconds": 0.19400175008922815
    },
    {
      "factId": "guide.13.06",
      "text": "定期擦拭不易看见的角落，避免积灰影响日常使用体验。",
      "sourceSamples16k": 79725,
      "padSamples": 275,
      "paddedSamples": 80000,
      "durationSeconds": 5.0,
      "pcmSHA256": "75e3da0e3b170ad88e5d1b200570a5197a1096e38028f46be6efdc1721c88f25",
      "synthesisWallSeconds": 0.17323229101020843
    },
    {
      "factId": "guide.13.07",
      "text": "整理时留意插座与线缆状态，不把收纳美观放在使用安全之前。",
      "sourceSamples16k": 96461,
      "padSamples": 179,
      "paddedSamples": 96640,
      "durationSeconds": 6.04,
      "pcmSHA256": "66e545dbad66b5afc6cd6e3e30a5e00b31017b048323c69f3171a5457d430294",
      "synthesisWallSeconds": 0.222302749985829
    },
    {
      "factId": "guide.13.08",
      "text": "重物放置在稳定位置，不集中堆在不适合承重的薄弱区域。",
      "sourceSamples16k": 91590,
      "padSamples": 570,
      "paddedSamples": 92160,
      "durationSeconds": 5.76,
      "pcmSHA256": "4ad3c37cb5da9416a24b4daba1aa317948157e6dae9a8271085b86cd279d755c",
      "synthesisWallSeconds": 0.19217441696673632
    },
    {
      "factId": "guide.13.09",
      "text": "需要抬动显示器等设备时先查看连接，避免拉扯仍插着的线缆。",
      "sourceSamples16k": 90830,
      "padSamples": 50,
      "paddedSamples": 90880,
      "durationSeconds": 5.68,
      "pcmSHA256": "db7b97cfe9e683ed62676ea1084160be7e4263979e65fbb0b35232c3b1d3fa32",
      "synthesisWallSeconds": 0.197801582980901
    },
    {
      "factId": "guide.13.10",
      "text": "维护发现的问题记录具体位置，下次调整时再逐项检查原因。",
      "sourceSamples16k": 90370,
      "padSamples": 510,
      "paddedSamples": 90880,
      "durationSeconds": 5.68,
      "pcmSHA256": "d3a76ea6516df5d335b150781f8481ee5442c6581be00ff51aa222b90acbbe84",
      "synthesisWallSeconds": 0.21359733399003744
    },
    {
      "factId": "guide.14.01",
      "text": "复盘时先询问哪些物品仍难找到，再考虑调整对应的分区。",
      "sourceSamples16k": 89361,
      "padSamples": 239,
      "paddedSamples": 89600,
      "durationSeconds": 5.6,
      "pcmSHA256": "e9bba8251e51881a600ad1dcd5b49a04d025aacbf8ec33fe134ce6e20426dd8f",
      "synthesisWallSeconds": 0.21911399997770786
    },
    {
      "factId": "guide.14.02",
      "text": "检查常用用品能否顺手放回，不只检查取出时是否方便。",
      "sourceSamples16k": 93155,
      "padSamples": 285,
      "paddedSamples": 93440,
      "durationSeconds": 5.84,
      "pcmSHA256": "b467098c7be5c1f15ee8ad3ae4dc9ba2834bd744f15e6c52ed408113b8434a8f",
      "synthesisWallSeconds": 0.2421710410853848
    },
    {
      "factId": "guide.14.03",
      "text": "观察每天收尾时剩下的物品，判断是否遗漏了固定收纳位置。",
      "sourceSamples16k": 92701,
      "padSamples": 99,
      "paddedSamples": 92800,
      "durationSeconds": 5.8,
      "pcmSHA256": "3f6caf608d65fbfa3d0bd3fc2bb0e1b6a85bd23bdfb9b952680dbb89a7070b4c",
      "synthesisWallSeconds": 0.2384436250431463
    },
    {
      "factId": "guide.14.04",
      "text": "工作内容变化时重新确认高频用品，不保留已经过时的桌面安排。",
      "sourceSamples16k": 100545,
      "padSamples": 575,
      "paddedSamples": 101120,
      "durationSeconds": 6.32,
      "pcmSHA256": "a76b683bc9980bf8ef1775c776cedf1bea316bc5cd96126a2568f10229d997b7",
      "synthesisWallSeconds": 0.23676516604609787
    },
    {
      "factId": "guide.14.05",
      "text": "某个容器持续放不下物品时，先检查分类而不是直接追加容器。",
      "sourceSamples16k": 96143,
      "padSamples": 497,
      "paddedSamples": 96640,
      "durationSeconds": 6.04,
      "pcmSHA256": "5cb6677b633b7001f1fcb4888014ce8f797e81cb69721681cc9fe1f70ac11332",
      "synthesisWallSeconds": 0.22219933394808322
    },
    {
      "factId": "guide.14.06",
      "text": "物品总在同一个位置聚集时，考虑把临时入口安排在那里。",
      "sourceSamples16k": 91623,
      "padSamples": 537,
      "paddedSamples": 92160,
      "durationSeconds": 5.76,
      "pcmSHA256": "007494b8b6d2a1a6fcbc5dc1ff0786361fb590d863e93b5f4c90c81ba4b12d0e",
      "synthesisWallSeconds": 0.2228022499475628
    },
    {
      "factId": "guide.14.07",
      "text": "调整方案之后试用几个完整任务，再判断布局是否适合自己。",
      "sourceSamples16k": 94055,
      "padSamples": 25,
      "paddedSamples": 94080,
      "durationSeconds": 5.88,
      "pcmSHA256": "6cbfbf1e0199d66d17c65ecb5e288813922fdc7b9569d4a12f676b65e696e92b",
      "synthesisWallSeconds": 0.20134100003633648
    },
    {
      "factId": "guide.14.08",
      "text": "保留能够持续执行的收尾动作，不用复杂流程增加维护负担。",
      "sourceSamples16k": 88646,
      "padSamples": 314,
      "paddedSamples": 88960,
      "durationSeconds": 5.56,
      "pcmSHA256": "9f439673a8897918a3cddd92dec76d4ece65baadff1c0fc9b7974a6828ff97e3",
      "synthesisWallSeconds": 0.19396608299575746
    },
