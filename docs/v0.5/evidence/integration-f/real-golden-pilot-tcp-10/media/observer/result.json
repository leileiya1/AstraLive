          "beatId": "beat_2fc261a9133d55febc94e714e33288d0",
          "segmentOrdinal": 3,
          "text": "本商品的规格选项只有电子版，请按电子资料使用。",
          "textHash": "sha256:9bcdce03971fbdf657271d718b18d65e131ccc78487bf0ef02ff48d012ce367d",
