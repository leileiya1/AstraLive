          "beatId": "beat_b74f4ae3f58f62ce34526a14b9306e60",
          "segmentOrdinal": 5,
          "text": "阅读时先选择最困扰你的桌面问题，再对应查找章节。",
          "textHash": "sha256:9964bb4964fdc8ce7e58cc0d3bc4c53c686f0410dfc793e8ea57198f7cb56bcf",
          "factIds": [
            "guide.01.06"
