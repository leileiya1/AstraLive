          "beatId": "beat_98de699e303334efe2643114e61f1e64",
          "segmentOrdinal": 7,
          "text": "第一次实践可以先处理一小块区域，再逐步扩大范围。",
          "textHash": "sha256:c65fe2f9a737801bbdb2b41e80c2358c3d81f0333456945f9766e747be878a7a",
          "factIds": [
            "guide.01.08"
