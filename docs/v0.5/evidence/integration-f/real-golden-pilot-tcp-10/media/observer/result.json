          "beatId": "beat_804f341b78cebb1b2472ba356b607dbd",
          "segmentOrdinal": 2,
          "text": "当前用于本次演示的商品库存，共有20份可供选择。",
          "textHash": "sha256:c1864f9d4b16f212ab91eafba8ec1f88171899a4853e0968bfeb914d99ea7320",
          "factIds": [
            "stock"
