# Research-only media and generated previews must not enter public Git.
musetalk/original/*
musetalk/normalized/*
soulx/original/*
soulx/normalized/*
audio/*.wav
previews/*

!musetalk/original/.gitkeep
!musetalk/normalized/.gitkeep
!soulx/original/.gitkeep
!soulx/normalized/.gitkeep
!audio/.gitkeep
!previews/.gitkeep
