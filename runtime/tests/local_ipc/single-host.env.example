# Frozen v0.5-frozen-1 names. Same environment goes to both local processes.
ASTRALIVE_LOCAL_TRANSPORT=uds
ASTRALIVE_LOCAL_FALLBACK=disabled
# Canonical absolute path; owned0700 parent. Use a short service-user directory.
ASTRALIVE_RUNTIME_UDS_PATH=/run/astralive/runtime.sock
# Used for rollback and unsupported-platform explicit startup fallback only.
AI_RUNTIME_URL=http://127.0.0.1:18000
RUNTIME_CONTROL_TOKEN_FILE=/etc/astralive/runtime-control-token
# Retain your existing separate binding/Tool tokens and provider configuration.
# Windows: ASTRALIVE_LOCAL_TRANSPORT=tcp; path not used; same control auth.
# macOS: e.g. /Users/your-user/.astralive-ipc/runtime.sock (<=103 UTF-8 bytes).
